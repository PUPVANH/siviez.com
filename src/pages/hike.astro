---
import Analytics from '@vercel/analytics/astro';
import SiviezNav from '../components/SiviezNav.astro';
---
<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hikes in Siviez · Bisses & alpine trails · siviez.com</title>
<meta name="description" content="A hand-drawn guide to the best hikes in Siviez and the 4 Vallées — bisses, alpine lakes, high mountain trails. Coming autumn 2026.">
<link rel="canonical" href="https://siviez.com/hike">
<link rel="icon" type="image/svg+xml" href="/favicons/siviez.svg">

<meta property="og:type" content="website">
<meta property="og:title" content="Hikes in Siviez · Bisses & alpine trails">
<meta property="og:description" content="A hand-drawn guide to the best hikes in Siviez and the 4 Vallées. Coming soon.">
<meta property="og:image" content="https://siviez.com/siviez/IMG_1797.jpg">
<meta property="og:url" content="https://siviez.com/hike">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Caveat:wght@500;600&display=swap" rel="stylesheet">

<style>
  :root {
    --teal:#0E6B6F; --gold:#C8A35F; --ember:#E85D2F;
    --ivory:#F4F0E8; --forest:#1E3A34; --paper:#FAF7F0;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  body {
    font-family:'Inter', sans-serif; font-weight:300; line-height:1.65;
    color:var(--ivory); -webkit-font-smoothing:antialiased;
  }
  .page {
    min-height:100vh; display:flex; flex-direction:column; justify-content:center;
    padding:120px 32px 60px; text-align:center;
    background:
      linear-gradient(180deg, rgba(15,38,34,0.4) 0%, rgba(15,38,34,0.15) 40%, rgba(15,38,34,0.7) 100%),
      url('/siviez/IMG_1797.jpg') center center/cover no-repeat;
  }
  .kicker {
    font-family:'JetBrains Mono',monospace; font-size:11px;
    letter-spacing:3px; text-transform:uppercase; color:var(--gold);
    margin-bottom:24px;
  }
  h1 {
    font-family:'Playfair Display',serif; font-weight:400;
    font-size:clamp(72px,12vw,160px); line-height:0.95; letter-spacing:-0.02em;
    margin-bottom:24px;
  }
  h1 em { font-style:italic; color:var(--gold); }
  .lede {
    max-width:620px; margin:0 auto 60px; font-size:18px; line-height:1.6;
    color:rgba(244,240,232,.85);
  }
  .lede em { color:var(--gold); font-style:italic; }

  .roadmap {
    max-width:520px; margin:0 auto 60px;
    background:rgba(30,58,52,0.5); backdrop-filter:blur(20px);
    border:1px solid rgba(200,163,95,0.25);
    padding:32px; border-radius:6px; text-align:left;
  }
  .roadmap-title {
    font-family:'JetBrains Mono',monospace; font-size:10px;
    letter-spacing:2px; text-transform:uppercase; color:var(--gold);
    margin-bottom:20px;
  }
  .roadmap ul {
    list-style:none; padding:0; margin:0;
    display:flex; flex-direction:column; gap:14px;
  }
  .roadmap li {
    display:flex; gap:14px; align-items:baseline;
    font-family:'Playfair Display',serif; font-size:17px;
    color:var(--ivory); font-style:italic;
  }
  .roadmap li::before {
    content:"➜"; color:var(--ember); font-family:'JetBrains Mono',monospace;
    font-size:13px; font-style:normal; flex-shrink:0;
  }
  .roadmap li strong { font-weight:500; color:var(--gold); font-style:normal; }

  .signature {
    font-family:'Caveat', cursive; font-size:24px; color:var(--gold);
    margin-bottom:40px;
  }

  .cta-row {
    display:flex; gap:16px; justify-content:center; flex-wrap:wrap;
  }
  .btn {
    display:inline-flex; align-items:center; gap:8px;
    font-family:'JetBrains Mono',monospace; font-size:11px;
    letter-spacing:1.5px; text-transform:uppercase;
    padding:14px 24px; border-radius:999px; text-decoration:none;
    transition:all 0.2s ease;
  }
  .btn-primary { background:var(--ember); color:var(--ivory); }
  .btn-primary:hover { background:var(--gold); color:var(--forest); transform:translateY(-2px); }
  .btn-ghost { background:transparent; color:var(--ivory); border:1px solid rgba(244,240,232,0.3); }
  .btn-ghost:hover { border-color:var(--gold); color:var(--gold); }

  footer {
    background:var(--forest); padding:40px 32px; text-align:center;
    font-family:'JetBrains Mono',monospace; font-size:10px;
    letter-spacing:1.5px; text-transform:uppercase; color:rgba(244,240,232,0.6);
  }
  footer .dot { color:var(--ember); margin:0 6px; }
  footer a { color:var(--gold); text-decoration:none; }

  @media (max-width:640px) {
    .page { padding:100px 20px 40px; }
    h1 { font-size:64px; }
    .roadmap { padding:24px; }
    .roadmap li { font-size:15px; }
  }
</style>
<Analytics />
</head>
<body>

<SiviezNav />

<section class="page">
  <div class="kicker">Coming autumn 2026</div>
  <h1>Hike <em>guide</em></h1>
  <p class="lede">
    A hand-drawn guide to the best <em>hikes in Siviez</em> and the 4 Vallées.
    Bisses, alpine lakes, high mountain trails — each with its own map, GPX, and Puppy's tip.
  </p>

  <div class="roadmap">
    <div class="roadmap-title">— Trails opening one by one</div>
    <ul>
      <li><strong>Lac de Cleuson</strong> — turquoise reservoir, 45 min drive up</li>
      <li><strong>Bisse du Milieu</strong> — easy shaded loop from Haute-Nendaz</li>
      <li><strong>Col des Gentianes</strong> — cable car to 2950m, panoramic</li>
      <li><strong>Bisses de Nendaz</strong> — eight of them, one per week</li>
    </ul>
  </div>

  <div class="signature">Watch this space.</div>

  <div class="cta-row">
    <a href="https://www.instagram.com/siviez" target="_blank" rel="noopener" class="btn btn-primary">
      <span>Follow @siviez ↗</span>
    </a>
    <a href="/" class="btn btn-ghost">
      <span>← Back home</span>
    </a>
  </div>
</section>

<footer>
  © 2026 · Hosted by Luc<span class="dot">·</span>Part of <a href="https://pupvanh.vercel.app" target="_blank" rel="noopener">PUPVANH Projects →</a>
</footer>

</body>
</html>
