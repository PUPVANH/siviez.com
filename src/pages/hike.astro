---
// /hike — The Grand Lac loop (Siviez–Combatseline–Lac de Cleuson–Lac du Grand Désert)
// with full segment breakdown, 5 route variants, the Saint-Laurent refuge, and
// four more trails from Siviez. Trilingual NL/EN/FR via the shared siviez-lang switch.
import Layout from '../layouts/Layout.astro';
import SiviezNav from '../components/SiviezNav.astro';

const pageTitle = 'Hiking Siviez · Siviez–Cleuson–Grand Désert loop & more trails';
const pageDescription = 'The Grand Lac loop from Siviez: Combatseline, Lac de Cleuson, Refuge Saint-Laurent and Lac du Grand Désert — 21 km, 1204 m, with five shorter variants. Plus four more trails from Siviez.';

const schema = {
  "@context": "https://schema.org",
  "@type": "ExercisePlan",
  "name": "Siviez – Combatseline – Lac de Cleuson – Lac du Grand Désert loop",
  "description": "A 21 km alpine loop from Siviez (Valais) via the Combatseline, Lac de Cleuson, the Saint-Laurent refuge and Lac du Grand Désert, returning over the Cleuson dam. 1204 m of ascent, 8-9 hours.",
  "url": "https://siviez.com/hike"
};
---

<Layout title={pageTitle} description={pageDescription} ogImage="https://siviez.com/photos/hike/printse-valley-towards-grand-desert.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <SiviezNav />

  <section class="hero">
    <div class="hero-inner">
      <div class="kicker" data-i18n="h.kicker">Hike · Valais · Swiss Alps</div>
      <h1>Hike <em data-i18n="h.title.em">Siviez</em></h1>
      <p class="hero-tag" data-i18n="h.tag">Turquoise reservoirs, an old high bisse, and alpine trails straight from the village door.</p>
    </div>
  </section>

  <div class="page">

    <section class="intro">
      <p class="lead" data-i18n="h.intro.lead">
        Siviez sits at the end of the valley, right at the foot of the trails — so there's no drive to a
        trailhead, you just start walking. Below is our favourite day out, in full detail, plus a handful of
        other walks from the village.
      </p>
      <p data-i18n="h.intro.body">
        The star of the show is the big loop up to the two lakes: the Lac de Cleuson and, higher still, the
        Lac du Grand Désert — turquoise water, a mountain refuge, and a moon-like desert of stone at nearly
        2750 metres. Here's everything you need to plan it, at any length.
      </p>
    </section>

    <!-- THE ROUTE -->
    <section class="route-head">
      <div class="section-kicker" data-i18n="h.route.kicker">Our favourite · The Grand Lac loop</div>
      <h2 class="route-title" data-i18n="h.route.title">Siviez – Combatseline – Lac de Cleuson – Lac du Grand Désert – Siviez</h2>
      <p class="route-sub" data-i18n="h.route.sub">The full loop, out and back to the village. All figures below are for the complete round trip.</p>
    </section>

    <section class="stats-strip">
      <div class="stat"><div class="sv">21 km</div><div class="sl" data-i18n="h.stat.dist">Distance</div></div>
      <div class="stat"><div class="sv">1204 m</div><div class="sl" data-i18n="h.stat.up">Ascent</div></div>
      <div class="stat"><div class="sv">8-9 h</div><div class="sl" data-i18n="h.stat.time">Time</div></div>
      <div class="stat"><div class="sv">2746 m</div><div class="sl" data-i18n="h.stat.high">High point</div></div>
      <div class="stat"><div class="sv" data-i18n="h.stat.looptype">Loop</div><div class="sl" data-i18n="h.stat.type">Type</div></div>
    </section>

    <section class="segments">
      <div class="section-kicker" data-i18n="h.seg.kicker">The full route</div>
      <h2 data-i18n="h.seg.title">Seven segments, one loop</h2>
      <p class="seg-intro" data-i18n="h.seg.intro">
        The full route on foot, broken into its natural stages. Every shorter variant is just this list,
        cut off earlier and looped back to the chapel.
      </p>

      <div class="seg-table">
        <div class="seg-row seg-head">
          <span data-i18n="h.seg.col.stage">Stage</span>
          <span class="num">km</span>
          <span class="num">↑ m</span>
          <span class="num">↓ m</span>
          <span class="num cum" data-i18n="h.seg.col.cum">Cumul.</span>
        </div>
        <div class="seg-row"><span data-i18n="h.seg.1">Siviez → Combatseline</span><span class="num">4.9</span><span class="num up">523</span><span class="num dn">22</span><span class="num cum">4.9</span></div>
        <div class="seg-row"><span data-i18n="h.seg.2">Combatseline → flank of Lac de Cleuson</span><span class="num">3.6</span><span class="num up">162</span><span class="num dn">70</span><span class="num cum">8.5</span></div>
        <div class="seg-row"><span data-i18n="h.seg.3">Flank → bridge over the Printse</span><span class="num">2.2</span><span class="num up">128</span><span class="num dn">137</span><span class="num cum">10.7</span></div>
        <div class="seg-row"><span data-i18n="h.seg.4">Bridge → Refuge Saint-Laurent</span><span class="num">1.2</span><span class="num up">158</span><span class="num dn">4</span><span class="num cum">11.9</span></div>
        <div class="seg-row"><span data-i18n="h.seg.5">Saint-Laurent → Lac du Grand Désert</span><span class="num">1.0</span><span class="num up">165</span><span class="num dn">4</span><span class="num cum">12.9</span></div>
        <div class="seg-row"><span data-i18n="h.seg.6">Grand Désert → Chapelle Saint-Barthélémy</span><span class="num">4.7</span><span class="num up">57</span><span class="num dn">513</span><span class="num cum">17.6</span></div>
        <div class="seg-row"><span data-i18n="h.seg.7">Chapelle → Siviez</span><span class="num">3.4</span><span class="num up">11</span><span class="num dn">462</span><span class="num cum">21.0</span></div>
        <div class="seg-row seg-total"><span data-i18n="h.seg.total">Full loop</span><span class="num">21.0</span><span class="num up">1204</span><span class="num dn">1212</span><span class="num cum">—</span></div>
      </div>
    </section>

    <section class="variants">
      <div class="section-kicker" data-i18n="h.var.kicker">Choose your day</div>
      <h2 data-i18n="h.var.title">Five ways to walk it</h2>
      <p class="var-intro" data-i18n="h.var.intro">
        From a half-day out to the lake, to the full loop to the desert of stone. All variants start on foot
        from Siviez and return over the Cleuson dam past the chapel — except where you take the lift up.
      </p>

      <div class="var-grid">
        <article class="var-card full">
          <div class="var-badge gold" data-i18n="h.var.full.badge">The full loop</div>
          <h3 data-i18n="h.var.full.name">To Lac du Grand Désert</h3>
          <div class="var-nums"><span>21 km</span><span>↑1204 m</span><span>8-9 h</span></div>
          <p data-i18n="h.var.full.body">The complete Grand Lac loop, all seven segments — Combatseline, the lake, the refuge, and the desert at 2746 m. A big, rewarding day.</p>
          <span class="var-level hard" data-i18n="h.level.hard">Demanding</span>
        </article>

        <article class="var-card">
          <div class="var-badge" data-i18n="h.var.stl.badge">Without the desert</div>
          <h3 data-i18n="h.var.stl.name">To Refuge Saint-Laurent</h3>
          <div class="var-nums"><span>19 km</span><span>↑1035 m</span><span>~6 h</span></div>
          <p data-i18n="h.var.stl.body">Turn back at the refuge instead of climbing on to the Grand Désert. Still the lake, the bridge and lunch at 2500 m.</p>
          <span class="var-level medhard" data-i18n="h.level.medhard">Medium-hard</span>
        </article>

        <article class="var-card">
          <div class="var-badge" data-i18n="h.var.bridge.badge">Without the refuge</div>
          <h3 data-i18n="h.var.bridge.name">To the Printse bridge</h3>
          <div class="var-nums"><span>18.6 km</span><span>↑997 m</span><span>~5 h</span></div>
          <p data-i18n="h.var.bridge.body">Follow the lake to the dry-stone bridge over the Printse, then cut back to the chapel. A long but gentler day.</p>
          <span class="var-level medium" data-i18n="h.level.medium">Medium</span>
        </article>

        <article class="var-card">
          <div class="var-badge" data-i18n="h.var.lake.badge">Shortest on foot</div>
          <h3 data-i18n="h.var.lake.name">To Lac de Cleuson</h3>
          <div class="var-nums"><span>13 km</span><span>↑699 m</span><span>3-4 h</span></div>
          <p data-i18n="h.var.lake.body">Up to the flank of the lake — my favourite view — then straight back down to the chapel. The most accessible way to see the turquoise water.</p>
          <span class="var-level easy" data-i18n="h.level.easy">Accessible</span>
        </article>

        <article class="var-card lift">
          <div class="var-badge ember" data-i18n="h.var.lift.badge">Save the first climb</div>
          <h3 data-i18n="h.var.lift.name">Full loop, lift up</h3>
          <div class="var-nums"><span>16 km</span><span>↑681 m</span><span>6-7 h</span></div>
          <p data-i18n="h.var.lift.body">Take the Combatseline chairlift from Siviez and skip the first 523 m of climbing. The full high loop, with far less effort to start.</p>
          <span class="var-level medium" data-i18n="h.level.medium">Medium</span>
        </article>
      </div>
    </section>

    <section class="feature">
      <div class="feature-text">
        <div class="section-kicker" data-i18n="h.up.kicker">The climb</div>
        <h2 data-i18n="h.up.title">Up to the lake</h2>
        <p data-i18n="h.up.p1">
          On foot, the route leaves Siviez past the Auberge car park, picks up a footpath to Chalet Novelly,
          then joins the (mostly gravel) road up to the Combatseline lifts and its café. That first stretch
          is the steepest of the whole day — 523 metres of climb — which is exactly why the chairlift makes
          such a good shortcut.
        </p>
        <p data-i18n="h.up.p2">
          From the top station the path softens, traversing the flank above the Lac de Cleuson. This is the
          stretch I'd walk for the view alone: the whole turquoise lake below, the dam wall, and the peaks
          of the Grand Désert ahead.
        </p>
      </div>
      <div class="feature-img">
        <img src="/photos/hike/trail-combatseline-lac-de-cleuson-stream.jpg" alt="Mountain stream along the Combatseline to Lac de Cleuson hiking trail, Siviez" loading="lazy" />
      </div>
    </section>

    <section class="feature reverse">
      <div class="feature-text">
        <div class="section-kicker" data-i18n="h.bridge.kicker">Deeper in</div>
        <h2 data-i18n="h.bridge.title">The Printse bridge</h2>
        <p data-i18n="h.bridge.p1">
          Past the lake, the trail drops to a dry-stone bridge over the young Printse river, then climbs
          again — steeper now — towards the refuge. This is where the big loop earns its name: the crowds
          thin out, and the landscape turns wild and mineral.
        </p>
        <p data-i18n="h.bridge.p2">
          If you're shortening the day, this is a natural turning point: cross back and follow the signs
          down to the chapel.
        </p>
      </div>
      <div class="feature-img">
        <img src="/photos/hike/printse-bridge-towards-refuge-saint-laurent.jpg" alt="Dry-stone bridge over the Printse river beyond Lac de Cleuson, towards Refuge de Saint-Laurent" loading="lazy" />
      </div>
    </section>

    <section class="refuge">
      <div class="section-kicker" data-i18n="h.ref.kicker">Halfway · lunch</div>
      <h2 data-i18n="h.ref.title">Refuge de <em>Saint-Laurent</em></h2>
      <div class="refuge-body">
        <p data-i18n="h.ref.p1">
          At 2500 metres, above the Cleuson dam, sits the Cabane Saint-Laurent — a mountain hut run by the
          local Ski-Club Arpettaz, and a genuinely lovely place to stop. Red parasols, deckchairs on the
          grass, and a terrace looking straight out over the lake.
        </p>
        <p data-i18n="h.ref.p2">
          It's the best spot on the route to eat properly, at a table: fondue, croûte, salads, soups and
          tarts, with running water, a WC and even a shower. It's usually staffed from the end of June to
          early September (in 2026: 3 July to 13 September).
        </p>
        <div class="tip">
          <span class="tip-label" data-i18n="h.tip.label">Puppy's tip</span>
          <p data-i18n="h.ref.tip">
            The refuge is seasonal, so don't count on it: carry enough water and a backup lunch anyway.
            When it's open, it's the highlight of the middle of the day. To be sure, reserve ahead by email
            at cabane@arpettaz.ch (there's no phone up there — lightning took out the mast).
          </p>
        </div>
      </div>
    </section>

    <section class="before">
      <div class="section-kicker" data-i18n="h.before.kicker">Before you go</div>
      <h2 data-i18n="h.before.title">Come prepared</h2>
      <div class="before-grid">
        <div class="before-card">
          <div class="bc-icon">☀</div>
          <h3 data-i18n="h.before.early.t">Start early</h3>
          <p data-i18n="h.before.early.b">It's an 8-9 hour day. Leave Siviez in the morning so you're off the high, exposed sections well before any afternoon weather.</p>
        </div>
        <div class="before-card">
          <div class="bc-icon">💧</div>
          <h3 data-i18n="h.before.water.t">Carry water</h3>
          <p data-i18n="h.before.water.b">Bring plenty — it's a long route and the refuge is seasonal. Don't rely on it being open; pack a backup lunch too.</p>
        </div>
        <div class="before-card">
          <div class="bc-icon">🥾</div>
          <h3 data-i18n="h.before.shoes.t">Proper shoes</h3>
          <p data-i18n="h.before.shoes.b">The upper sections are rocky and steep in places. Sturdy hiking boots with grip, not trainers.</p>
        </div>
        <div class="before-card">
          <div class="bc-icon">⛅</div>
          <h3 data-i18n="h.before.weather.t">Check the weather</h3>
          <p data-i18n="h.before.weather.b">This is high mountain terrain and it can turn quickly. Check the forecast the evening before and again in the morning.</p>
        </div>
      </div>
    </section>

    <section class="others">
      <div class="section-kicker" data-i18n="h.other.kicker">More from Siviez</div>
      <h2 data-i18n="h.other.title">Other trails</h2>
      <p class="others-intro" data-i18n="h.other.intro">
        A few more walks that start from or near Siviez, from an easy family stroll to full alpine days.
        Distances and times are indicative — check current conditions before you set out.
      </p>

      <div class="others-grid">
        <article class="other-card">
          <h3 data-i18n="h.other.jp.name">Japanese Garden via Siviez</h3>
          <div class="other-nums"><span>9.5 km</span><span>↑562 m</span><span>4-4.5 h</span><span class="lvl med" data-i18n="h.level.medium">Medium</span></div>
          <p data-i18n="h.other.jp.body">A circular hike to the "Japanese Garden", a natural setting on the glacier moraine towards Col des Gentianes.</p>
        </article>
        <article class="other-card">
          <h3 data-i18n="h.other.saxon.name">Bisse de Saxon via Siviez</h3>
          <div class="other-nums"><span>18 km</span><span>↑821 m</span><span>6.5-7 h</span><span class="lvl hard" data-i18n="h.level.hard">Hard</span></div>
          <p data-i18n="h.other.saxon.body">A long out-and-back along one of the region's historic bisses, with wide views over the Rhône valley.</p>
        </article>
        <article class="other-card">
          <h3 data-i18n="h.other.dent.name">Dent de Nendaz – Tracouet – Balavaux</h3>
          <div class="other-nums"><span>17.1 km</span><span>↑1213 m</span><span>7.5-8 h</span><span class="lvl hard" data-i18n="h.level.hard">Hard</span></div>
          <p data-i18n="h.other.dent.body">A demanding loop over the Dent de Nendaz ridge, past Tracouet and the Balavaux hut, through forest and lakes.</p>
        </article>
        <article class="other-card">
          <h3 data-i18n="h.other.vieux.name">Tortin – Haute-Nendaz via Bisse Vieux</h3>
          <div class="other-nums"><span>6.9 km</span><span>↑109 m</span><span>2-2.5 h</span><span class="lvl easy" data-i18n="h.level.easy">Easy</span></div>
          <p data-i18n="h.other.vieux.body">An easy, mostly downhill walk along the Bisse Vieux beside the Printse — kid-friendly and shaded.</p>
        </article>
      </div>
    </section>

    <section class="cta">
      <h2 data-i18n="h.cta.title">Stay at the trailhead</h2>
      <p data-i18n="h.cta.body">Every one of these walks starts a few minutes from Rosablanche C34 — dry your boots, rest your legs, and go again tomorrow.</p>
      <div class="cta-buttons">
        <a href="/appartement" class="btn btn-primary" data-track="hike_to_apartment" data-i18n="h.cta.stay">See the apartment →</a>
        <a href="/discover/village" class="btn btn-ghost" data-i18n="h.cta.village">Discover the village</a>
      </div>
    </section>

    <footer>
      <span>© 2026 · Hosted by Luc</span>
      <span class="dot">·</span>
      <span>Part of <a href="https://pupvanh.vercel.app" target="_blank" rel="noopener">PUPVANH Projects →</a></span>
    </footer>

  </div>
</Layout>

<style>
  .hero {
    position: relative; min-height: 80vh; display: flex; align-items: flex-end;
    padding: 120px 24px 60px; color: #F4F0E8;
    background:
      linear-gradient(180deg, rgba(15,38,34,0.35) 0%, rgba(15,38,34,0.2) 35%, rgba(15,38,34,0.8) 100%),
      url('/photos/hike/printse-valley-towards-grand-desert.jpg') center 50% / cover no-repeat;
  }
  .hero-inner { max-width: 1100px; margin: 0 auto; width: 100%; }
  .kicker { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: #C8A35F; margin-bottom: 18px; }
  h1 { font-family: 'Playfair Display', serif; font-weight: 400; font-size: clamp(48px, 8vw, 104px); line-height: 0.98; letter-spacing: -0.02em; margin: 0 0 18px 0; }
  h1 em { font-style: italic; color: #C8A35F; }
  .hero-tag { font-family: 'Playfair Display', serif; font-style: italic; font-size: clamp(17px, 2.6vw, 24px); color: rgba(244,240,232,0.92); max-width: 640px; }

  .page { background: #0F2622; color: #F4F0E8; }
  .page section { max-width: 1100px; margin: 0 auto; padding: 72px 24px; }

  .section-kicker { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: #C8A35F; margin-bottom: 16px; }
  h2 { font-family: 'Playfair Display', serif; font-weight: 400; font-size: clamp(30px, 4.5vw, 52px); line-height: 1.05; letter-spacing: -0.015em; margin-bottom: 22px; }
  h2 em { font-style: italic; color: #C8A35F; }
  p { font-size: 17px; line-height: 1.75; color: rgba(244,240,232,0.82); margin-bottom: 18px; }

  .stats-strip {
    display: flex; flex-wrap: wrap; gap: 0; justify-content: space-between;
    background: rgba(30,58,52,0.5); border: 1px solid rgba(200,163,95,0.2);
    border-radius: 10px; padding: 28px 20px; margin-top: -40px; position: relative; z-index: 2;
  }
  .stats-strip .stat { flex: 1; min-width: 90px; text-align: center; padding: 4px 8px; }
  .stats-strip .sv { font-family: 'Playfair Display', serif; font-size: clamp(22px, 3vw, 32px); color: #C8A35F; line-height: 1; }
  .stats-strip .sl { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: rgba(244,240,232,0.6); margin-top: 8px; }

  .intro .lead { font-family: 'Playfair Display', serif; font-style: italic; font-size: clamp(20px, 3vw, 28px); line-height: 1.5; color: #C8A35F; margin-bottom: 26px; }
  .intro { border-bottom: 1px solid rgba(200,163,95,0.15); }

  /* ROUTE HEAD */
  .route-head { padding-bottom: 0; }
  .route-title {
    font-family: 'Playfair Display', serif; font-weight: 400;
    font-size: clamp(24px, 3.4vw, 40px); line-height: 1.15; letter-spacing: -0.01em;
    color: #F4F0E8; margin-bottom: 14px;
  }
  .route-sub {
    font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.5px;
    color: rgba(244,240,232,0.6); max-width: 640px; margin-bottom: 0;
  }

  .segments { border-bottom: 1px solid rgba(200,163,95,0.15); }
  .seg-intro { max-width: 640px; margin-bottom: 32px; }
  .seg-table { border: 1px solid rgba(200,163,95,0.2); border-radius: 8px; overflow: hidden; }
  .seg-row { display: grid; grid-template-columns: 1fr 56px 56px 56px 64px; align-items: center; padding: 14px 18px; font-size: 14px; border-bottom: 1px solid rgba(200,163,95,0.1); }
  .seg-row:last-child { border-bottom: none; }
  .seg-row .num { text-align: right; font-family: 'JetBrains Mono', monospace; font-size: 13px; }
  .seg-head { background: rgba(200,163,95,0.12); font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1px; text-transform: uppercase; color: #C8A35F; }
  .seg-row .up { color: #E8A05D; }
  .seg-row .dn { color: rgba(244,240,232,0.5); }
  .seg-row .cum { color: rgba(244,240,232,0.6); }
  .seg-row span:first-child { color: rgba(244,240,232,0.88); padding-right: 8px; }
  .seg-total { background: rgba(30,58,52,0.6); font-family: 'Playfair Display', serif; }
  .seg-total span:first-child { color: #F4F0E8; font-size: 16px; }
  .seg-total .num { color: #C8A35F; font-weight: 500; }

  .variants { border-bottom: 1px solid rgba(200,163,95,0.15); }
  .var-intro { max-width: 640px; margin-bottom: 36px; }
  .var-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .var-card { background: rgba(30,58,52,0.5); border: 1px solid rgba(200,163,95,0.2); border-radius: 8px; padding: 26px 24px; display: flex; flex-direction: column; }
  .var-card.full { border-color: rgba(200,163,95,0.5); background: rgba(30,58,52,0.7); }
  .var-card.lift { border-color: rgba(232,93,47,0.4); }
  .var-badge { align-self: flex-start; font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(244,240,232,0.7); background: rgba(244,240,232,0.08); padding: 4px 10px; border-radius: 2px; margin-bottom: 16px; }
  .var-badge.gold { background: #C8A35F; color: #1E3A34; }
  .var-badge.ember { background: #E85D2F; color: #F4F0E8; }
