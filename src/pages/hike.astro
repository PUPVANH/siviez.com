      "h.other.vieux.name": "Tortin – Haute-Nendaz via Bisse Vieux", "h.other.vieux.body": "Een makkelijke, grotendeels dalende wandeling langs de Bisse Vieux naast de Printse — kindvriendelijk en schaduwrijk.",
      "h.cta.title": "Verblijf aan het vertrekpunt", "h.cta.body": "Elk van deze wandelingen start op een paar minuten van Rosablanche C34 — droog je schoenen, rust je benen, en ga morgen weer.",
      "h.cta.stay": "Bekijk het appartement →", "h.cta.village": "Ontdek het dorp"
    },
    fr: {
      "h.kicker": "Randonnée · Valais · Alpes Suisses",
      "h.title.em": "Siviez",
      "h.tag": "Réservoirs turquoise, un ancien bisse d'altitude, et des sentiers alpins au pas de la porte du village.",
      "h.stat.dist": "Distance", "h.stat.up": "Dénivelé", "h.stat.time": "Durée", "h.stat.high": "Point haut", "h.stat.type": "Type", "h.stat.looptype": "Boucle",
      "h.intro.lead": "Siviez se trouve au bout de la vallée, juste au pied des sentiers — donc pas de route jusqu'à un départ, on se met simplement à marcher. Ci-dessous, notre sortie préférée, en détail complet, plus quelques autres marches depuis le village.",
      "h.intro.body": "La vedette, c'est la grande boucle jusqu'aux deux lacs : le Lac de Cleuson et, plus haut encore, le Lac du Grand Désert — eau turquoise, un refuge de montagne, et un désert de pierre lunaire à près de 2750 mètres. Voici tout ce qu'il faut pour la planifier, à n'importe quelle longueur.",
      "h.route.kicker": "Notre préférée · The Grand Lac loop",
      "h.route.title": "Siviez – Combatseline – Lac de Cleuson – Lac du Grand Désert – Siviez",
      "h.route.sub": "La boucle complète, aller-retour au village. Tous les chiffres ci-dessous concernent la boucle entière.",
      "h.seg.kicker": "L'itinéraire complet", "h.seg.title": "Sept segments, une boucle",
      "h.seg.intro": "L'itinéraire complet à pied, découpé en étapes naturelles. Chaque variante plus courte n'est que cette liste, interrompue plus tôt et bouclée vers la chapelle.",
      "h.seg.col.stage": "Étape", "h.seg.col.cum": "Cumul.",
      "h.seg.1": "Siviez → Combatseline", "h.seg.2": "Combatseline → flanc du Lac de Cleuson", "h.seg.3": "Flanc → pont sur la Printse", "h.seg.4": "Pont → Refuge Saint-Laurent", "h.seg.5": "Saint-Laurent → Lac du Grand Désert", "h.seg.6": "Grand Désert → Chapelle Saint-Barthélémy", "h.seg.7": "Chapelle → Siviez", "h.seg.total": "Boucle complète",
      "h.var.kicker": "Choisissez votre journée", "h.var.title": "Cinq façons de la parcourir",
      "h.var.intro": "D'une demi-journée jusqu'au lac, à la boucle complète jusqu'au désert de pierre. Toutes les variantes partent à pied de Siviez et reviennent par le barrage de Cleuson en passant par la chapelle — sauf quand vous prenez le télésiège.",
      "h.var.full.badge": "La boucle complète", "h.var.full.name": "Jusqu'au Lac du Grand Désert", "h.var.full.body": "La boucle Grand Lac complète, les sept segments — Combatseline, le lac, le refuge et le désert à 2746 m. Une grande journée, gratifiante.",
      "h.var.stl.badge": "Sans le désert", "h.var.stl.name": "Jusqu'au Refuge Saint-Laurent", "h.var.stl.body": "Faites demi-tour au refuge au lieu de monter jusqu'au Grand Désert. Toujours le lac, le pont et le déjeuner à 2500 m.",
      "h.var.bridge.badge": "Sans le refuge", "h.var.bridge.name": "Jusqu'au pont de la Printse", "h.var.bridge.body": "Suivez le lac jusqu'au pont de pierres sèches sur la Printse, puis coupez vers la chapelle. Une journée longue mais plus douce.",
      "h.var.lake.badge": "Le plus court à pied", "h.var.lake.name": "Jusqu'au Lac de Cleuson", "h.var.lake.body": "Jusqu'au flanc du lac — ma vue préférée — puis directement en bas vers la chapelle. La façon la plus accessible de voir l'eau turquoise.",
      "h.var.lift.badge": "Épargnez la première montée", "h.var.lift.name": "Boucle complète, télésiège", "h.var.lift.body": "Prenez le télésiège de Combatseline depuis Siviez et sautez les premiers 523 m de montée. La boucle d'altitude complète, avec bien moins d'effort au départ.",
      "h.level.hard": "Exigeant", "h.level.medhard": "Moyen-difficile", "h.level.medium": "Moyen", "h.level.easy": "Accessible",
      "h.up.kicker": "La montée", "h.up.title": "Jusqu'au lac",
      "h.up.p1": "À pied, l'itinéraire quitte Siviez en passant devant le parking de l'Auberge, emprunte un sentier jusqu'au Chalet Novelly, puis rejoint la route (surtout en gravier) jusqu'aux remontées de Combatseline et son café. Ce premier tronçon est le plus raide de la journée — 523 mètres de montée — et c'est précisément pourquoi le télésiège fait un si bon raccourci.",
      "h.up.p2": "Depuis la station supérieure, le sentier s'adoucit, traversant le flanc au-dessus du Lac de Cleuson. C'est le tronçon que je ferais rien que pour la vue : tout le lac turquoise en contrebas, le barrage, et les sommets du Grand Désert devant.",
      "h.bridge.kicker": "Plus loin", "h.bridge.title": "Le pont de la Printse",
      "h.bridge.p1": "Après le lac, le sentier descend vers un pont de pierres sèches sur la jeune Printse, puis remonte — plus raide maintenant — vers le refuge. C'est là que la grande boucle mérite son nom : la foule s'éclaircit, et le paysage devient sauvage et minéral.",
      "h.bridge.p2": "Si vous raccourcissez la journée, c'est un point de demi-tour naturel : retraversez et suivez les panneaux vers la chapelle.",
      "h.ref.kicker": "À mi-parcours · déjeuner", "h.ref.title": "Saint-Laurent",
      "h.ref.p1": "À 2500 mètres, au-dessus du barrage de Cleuson, se trouve la Cabane Saint-Laurent — un refuge géré par le Ski-Club Arpettaz local, et un endroit vraiment charmant pour s'arrêter. Parasols rouges, chaises longues sur l'herbe, et une terrasse qui donne droit sur le lac.",
      "h.ref.p2": "C'est le meilleur endroit de l'itinéraire pour manger correctement, à table : fondue, croûte, salades, soupes et tartes, avec eau courante, WC et même une douche. Généralement gardé de fin juin à début septembre (en 2026 : du 3 juillet au 13 septembre).",
      "h.tip.label": "Le conseil de Puppy",
      "h.ref.tip": "Le refuge est saisonnier, alors n'y comptez pas : emportez de toute façon assez d'eau et un déjeuner de secours. Quand il est ouvert, c'est le point fort du milieu de journée. Pour être sûr, réservez à l'avance par e-mail à cabane@arpettaz.ch (il n'y a plus de téléphone là-haut — la foudre a détruit l'antenne).",
      "h.before.kicker": "Avant de partir", "h.before.title": "Venez préparé",
      "h.before.early.t": "Partez tôt", "h.before.early.b": "C'est une journée de 8 à 9 heures. Quittez Siviez le matin pour être hors des sections hautes et exposées bien avant tout orage de l'après-midi.",
      "h.before.water.t": "Emportez de l'eau", "h.before.water.b": "Prenez-en beaucoup — c'est un long itinéraire et le refuge est saisonnier. Ne comptez pas sur son ouverture ; emportez aussi un déjeuner de secours.",
      "h.before.shoes.t": "Bonnes chaussures", "h.before.shoes.b": "Les sections hautes sont rocheuses et raides par endroits. Des chaussures de randonnée solides avec de l'accroche, pas des baskets.",
      "h.before.weather.t": "Vérifiez la météo", "h.before.weather.b": "C'est de la haute montagne et le temps peut vite tourner. Vérifiez les prévisions la veille au soir et à nouveau le matin.",
      "h.other.kicker": "Plus depuis Siviez", "h.other.title": "Autres sentiers",
      "h.other.intro": "Quelques autres marches qui partent de Siviez ou à proximité, d'une balade familiale facile à de vraies journées alpines. Distances et durées indicatives — vérifiez les conditions actuelles avant de partir.",
      "h.other.jp.name": "Japanese Garden via Siviez", "h.other.jp.body": "Une randonnée en boucle vers le « Japanese Garden », un cadre naturel sur la moraine glaciaire vers le Col des Gentianes.",
      "h.other.saxon.name": "Bisse de Saxon via Siviez", "h.other.saxon.body": "Un long aller-retour le long d'un des bisses historiques de la région, avec de larges vues sur la vallée du Rhône.",
      "h.other.dent.name": "Dent de Nendaz – Tracouet – Balavaux", "h.other.dent.body": "Une boucle exigeante par la crête de la Dent de Nendaz, en passant par Tracouet et la cabane de Balavaux, à travers forêts et lacs.",
      "h.other.vieux.name": "Tortin – Haute-Nendaz via Bisse Vieux", "h.other.vieux.body": "Une marche facile, surtout en descente, le long du Bisse Vieux au bord de la Printse — adaptée aux enfants et ombragée.",
      "h.cta.title": "Logez au départ du sentier", "h.cta.body": "Chacune de ces marches part à quelques minutes de Rosablanche C34 — séchez vos chaussures, reposez vos jambes, et repartez demain.",
      "h.cta.stay": "Voir l'appartement →", "h.cta.village": "Découvrir le village"
    }
  };

  function setLang(lang) {
    const dict = translations[lang] || translations.en;
    document.querySelectorAll('[data-i18n]').forEach(function(el) {
      const key = el.getAttribute('data-i18n');
      if (dict[key]) el.textContent = dict[key];
    });
    try { localStorage.setItem('siviez-lang', lang); } catch(e){}
  }
  window.addEventListener('siviez-lang-change', function(e) { setLang(e.detail.lang); });
  let initial = 'en';
  try {
    const stored = localStorage.getItem('siviez-lang');
    if (stored) initial = stored;
    else if (navigator.language) { const b = navigator.language.slice(0,2); if (translations[b]) initial = b; }
  } catch(e) {}
  setLang(initial);
</script>
