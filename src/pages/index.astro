---
import Layout from '../layouts/Layout.astro';
import SiviezNav from '../components/SiviezNav.astro';
---

<Layout>
  <SiviezNav />

  <section class="hero">
    <div class="hero-inner">
      <div class="kicker" data-i18n="hero.kicker">Valais · Swiss Alps</div>
      <h1>Siviez</h1>
      <div class="hero-tag" data-i18n="hero.tag">1730m up in the mountains</div>
      <p class="hero-lede">
        <span data-i18n="hero.lede.a">Where the</span>
        <em>4 Vallées</em>
        <span data-i18n="hero.lede.b">begin. Turquoise lakes, ancient bisses and 400 km of pistes right outside.</span>
      </p>

      <div class="stats">
        <div class="stat">
          <div class="stat-value">1730</div>
          <div class="stat-label" data-i18n="stat.altitude">Altitude</div>
        </div>
        <div class="stat-sep"></div>
        <div class="stat">
          <div class="stat-value">410</div>
          <div class="stat-label" data-i18n="stat.slopes">Km slopes</div>
        </div>
        <div class="stat-sep"></div>
        <div class="stat">
          <div class="stat-value">8</div>
          <div class="stat-label" data-i18n="stat.bisses">Bisses</div>
        </div>
        <div class="stat-sep"></div>
        <div class="stat">
          <div class="stat-value">3336</div>
          <div class="stat-label" data-i18n="stat.peak">Peak</div>
        </div>
      </div>

      <div class="cards">
        <a href="/hike" class="card">
          <div class="card-label" data-i18n="card.hike.label">Hike</div>
          <h3 class="card-title">Hike <em>guide</em></h3>
          <div class="card-credit" data-i18n="card.hike.credit">Trails, bisses & alpine lakes</div>
          <p class="card-body" data-i18n="card.hike.body">
            The Combatselina to Cleuson dam classic, the bisses de Nendaz, and every route around Rosablanche.
          </p>
          <div class="card-cta" data-i18n="card.hike.cta">Explore trails →</div>
        </a>

        <a href="/ski" class="card">
          <div class="card-label" data-i18n="card.ski.label">Ski</div>
          <h3 class="card-title">Ski <em>the 4 Vallées</em></h3>
          <div class="card-credit" data-i18n="card.ski.credit">410 km · ski-in/ski-out</div>
          <p class="card-body" data-i18n="card.ski.body">
            One of the largest ski areas in the world, straight from the doorstep. Mont Fort at 3330m.
          </p>
          <div class="card-cta" data-i18n="card.ski.cta">See the pistes →</div>
        </a>

        <a href="#discover" class="card">
          <div class="card-label" data-i18n="card.discover.label">Discover</div>
          <h3 class="card-title">The <em>village</em></h3>
          <div class="card-credit" data-i18n="card.discover.credit">1730m · Valais · practical info</div>
          <p class="card-body" data-i18n="card.discover.body">
            The place, how to get there, what makes Siviez what it is — everything you'd want to know before you come.
          </p>
          <div class="card-cta" data-i18n="card.discover.cta">More about Siviez →</div>
        </a>

        <a href="/appartement" class="card card-emphasis">
          <div class="card-label" data-i18n="card.stay.label">Stay</div>
          <h3 class="card-title">Rosablanche <em>C34</em></h3>
          <div class="card-credit" data-i18n="card.stay.credit">Ski-in / ski-out · sleeps 7</div>
          <p class="card-body" data-i18n="card.stay.body">
            A spacious mountain apartment in the heart of Siviez. South-facing terrace, free parking and the slopes at your door.
          </p>
          <div class="card-cta" data-i18n="card.stay.cta">Read more →</div>
        </a>
      </div>

      <a href="https://www.instagram.com/siviez" target="_blank" rel="noopener" class="insta-cta">
        <span class="insta-icon">✧</span>
        <span data-i18n="insta.cta">Follow @siviez on Instagram</span>
        <span class="insta-arrow">↗</span>
      </a>
    </div>
  </section>

  <!-- DISCOVER: MEER OVER SIVIEZ -->
  <section id="discover" class="discover">
    <div class="discover-inner">
      <div class="kicker" data-i18n="disc.kicker">Discover</div>
      <h2>More about <em>Siviez</em>.</h2>
      <p class="discover-lede" data-i18n="disc.lede">
        A small alpine village at 1730m, at the end of the Nendaz valley — where four ski valleys meet and endless summer trails begin.
      </p>

      <div class="disc-grid">

        <div class="disc-block">
          <div class="disc-num">01</div>
          <h3 data-i18n="disc.village.title">The village</h3>
          <p data-i18n="disc.village.body">
            Siviez sits at 1730m, at the head of the Nendaz valley. A handful of buildings and hotels, one supermarket, one bakery. Quiet in the low seasons, busy but never overwhelming when the lifts are running.
          </p>
        </div>

        <div class="disc-block">
          <div class="disc-num">02</div>
          <h3 data-i18n="disc.getting.title">Getting there</h3>
          <p data-i18n="disc.getting.body">
            40 minutes by car from Sion airport, up winding mountain roads. From Geneva it's a scenic 2 hours. By public transport: train to Sion, bus 361 to Haute-Nendaz, then shuttle up to Siviez.
          </p>
        </div>

        <div class="disc-block">
          <div class="disc-num">03</div>
          <h3 data-i18n="disc.season.title">Winter & summer</h3>
          <p data-i18n="disc.season.body">
            Winter: the 4 Vallées ski area (410 km of pistes) starts at the doorstep. Summer: alpine hiking, the bisses de Nendaz, and the turquoise reservoir of Cleuson a short drive up.
          </p>
        </div>

        <div class="disc-block">
          <div class="disc-num">04</div>
          <h3 data-i18n="disc.practical.title">Practical</h3>
          <p data-i18n="disc.practical.body">
            One small supermarket in the Rosablanche building for essentials. Ski schools and rental at the foot of the lift. Restaurants both in the village and on the slopes. Pharmacy and doctor in Haute-Nendaz, hospital in Sion.
          </p>
        </div>

      </div>

      <div class="disc-note">
        <div class="kicker" data-i18n="disc.next.kicker">Next</div>
        <p data-i18n="disc.next.body">
          Ready to visit? <a href="/appartement">Rosablanche C34</a> sleeps 7 and sits at the foot of the Combatselina chairlift.
          Or check out the <a href="/hike">summer trails</a> and <a href="/ski">winter pistes</a> first.
        </p>
      </div>
    </div>
  </section>

  <footer>
    <span>© 2026 · Hosted by Luc</span>
    <span class="dot">·</span>
    <span>Part of <a href="https://pupvanh.vercel.app" target="_blank" rel="noopener">PUPVANH Projects →</a></span>
  </footer>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    padding: 120px 24px 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #F4F0E8;
    background:
      linear-gradient(180deg, rgba(15,38,34,0.55) 0%, rgba(15,38,34,0.30) 30%, rgba(15,38,34,0.65) 75%, rgba(15,38,34,0.95) 100%),
      url('/Siviez/view-sion-valley.jpg') center 40% / cover no-repeat;
  }
  .hero-inner { max-width: 1200px; width: 100%; }

  .kicker {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #C8A35F;
    margin-bottom: 24px;
  }
  h1 {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-size: clamp(80px, 14vw, 180px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 20px 0;
  }
  .hero-tag {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 22px;
    color: #C8A35F;
    margin-bottom: 32px;
  }
  .hero-lede {
    max-width: 640px;
    margin: 0 auto 60px;
    font-size: 20px;
    line-height: 1.55;
    color: rgba(244, 240, 232, 0.9);
    font-family: 'Playfair Display', serif;
  }
  .hero-lede em { color: #C8A35F; font-style: italic; }

  .stats {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding: 20px 32px;
    background: rgba(30, 58, 52, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(200, 163, 95, 0.25);
    border-radius: 999px;
    margin-bottom: 60px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .stat { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .stat-value {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 26px;
    color: #C8A35F;
    line-height: 1;
  }
  .stat-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(244, 240, 232, 0.6);
  }
  .stat-sep { width: 1px; height: 30px; background: rgba(200, 163, 95, 0.3); }

  .cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    max-width: 1200px;
    margin: 0 auto 40px;
    width: 100%;
  }
  .card {
    background: rgba(30, 58, 52, 0.55);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(200, 163, 95, 0.25);
    padding: 28px 24px;
    border-radius: 6px;
    text-align: left;
    color: inherit;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;
    cursor: pointer;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: rgba(200, 163, 95, 0.55);
    background: rgba(30, 58, 52, 0.75);
  }
  .card-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #C8A35F;
    margin-bottom: 12px;
  }
  .card-title {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-size: 24px;
    line-height: 1.1;
    color: #F4F0E8;
    margin: 0 0 6px 0;
  }
  .card-title em { font-style: italic; color: #C8A35F; }
  .card-credit {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: rgba(244, 240, 232, 0.55);
    margin-bottom: 14px;
    letter-spacing: 0.5px;
  }
  .card-body {
    font-size: 13px;
    color: rgba(244, 240, 232, 0.78);
    line-height: 1.55;
    margin: 0 0 18px 0;
    flex: 1;
    font-family: 'Inter', sans-serif;
  }
  .card-cta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #C8A35F;
    padding-top: 14px;
    border-top: 1px solid rgba(200, 163, 95, 0.2);
    transition: color 0.2s ease;
  }
  .card:hover .card-cta { color: #F4F0E8; }
  .card-emphasis .card-cta { color: #E85D2F; }
  .card-emphasis:hover .card-cta { color: #F4F0E8; }

  /* INSTAGRAM CTA */
  .insta-cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 32px;
    background: rgba(30, 58, 52, 0.4);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(200, 163, 95, 0.35);
    border-radius: 999px;
    color: #F4F0E8;
    text-decoration: none;
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 18px;
    transition: all 0.3s ease;
    margin-top: 20px;
  }
  .insta-cta:hover {
    border-color: #C8A35F;
    background: rgba(200, 163, 95, 0.15);
    transform: translateY(-2px);
  }
  .insta-icon { color: #E85D2F; font-size: 16px; }
  .insta-arrow { color: #C8A35F; font-size: 14px; }

  /* DISCOVER SECTION */
  .discover {
    background: #0F2622;
    padding: 120px 24px 100px;
    color: #F4F0E8;
    border-top: 1px solid rgba(200, 163, 95, 0.15);
  }
  .discover-inner {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  h2 {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-size: clamp(48px, 6vw, 84px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 24px 0;
  }
  h2 em { font-style: italic; color: #C8A35F; }
  .discover-lede {
    max-width: 620px;
    margin: 0 auto 80px;
    font-size: 18px;
    line-height: 1.6;
    color: rgba(244, 240, 232, 0.75);
    font-family: 'Playfair Display', serif;
    font-style: italic;
  }

  .disc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    text-align: left;
    margin-bottom: 60px;
  }
  .disc-block {
    padding: 40px;
    background: rgba(30, 58, 52, 0.4);
    border: 1px solid rgba(200, 163, 95, 0.15);
    border-radius: 6px;
    position: relative;
  }
  .disc-num {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 42px;
    color: #C8A35F;
    line-height: 1;
    margin-bottom: 16px;
    opacity: 0.8;
  }
  .disc-block h3 {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-size: 26px;
    color: #F4F0E8;
    margin: 0 0 14px 0;
    line-height: 1.15;
  }
  .disc-block p {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: rgba(244, 240, 232, 0.78);
    margin: 0;
  }

  .disc-note {
    padding: 32px;
    background: rgba(232, 93, 47, 0.08);
    border-left: 3px solid #E85D2F;
    border-radius: 4px;
    text-align: left;
    max-width: 720px;
    margin: 0 auto;
  }
  .disc-note p {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 18px;
    line-height: 1.6;
    color: rgba(244, 240, 232, 0.9);
    margin: 8px 0 0 0;
  }
  .disc-note a { color: #C8A35F; text-decoration: none; }
  .disc-note a:hover { color: #F4F0E8; }

  /* FOOTER */
  footer {
    background: #0F2622;
    padding: 40px 24px;
    text-align: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(244, 240, 232, 0.5);
    border-top: 1px solid rgba(200, 163, 95, 0.1);
  }
  footer .dot { color: #E85D2F; margin: 0 8px; }
  footer a { color: #C8A35F; text-decoration: none; }

  /* SMOOTH SCROLL */
  html { scroll-behavior: smooth; }

  /* RESPONSIVE */
  @media (max-width: 1000px) {
    .cards { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .disc-grid { grid-template-columns: 1fr; gap: 20px; }
  }
  @media (max-width: 640px) {
    .cards { grid-template-columns: 1fr; gap: 14px; }
    .hero { padding: 100px 16px 60px; }
    .hero-lede { font-size: 17px; }
    .stats { gap: 14px; padding: 16px 22px; }
    .stat-value { font-size: 22px; }
    .stat-sep { height: 24px; }
    .card { padding: 24px 20px; }
    .card-title { font-size: 22px; }
    .insta-cta { font-size: 15px; padding: 14px 24px; }
    .discover { padding: 80px 16px 60px; }
    .disc-block { padding: 28px 24px; }
    .disc-block h3 { font-size: 22px; }
  }
  @media (max-width: 420px) {
    .stats { gap: 10px; padding: 14px 18px; }
    .stat-sep { display: none; }
    .stat { min-width: 60px; }
  }
</style>

