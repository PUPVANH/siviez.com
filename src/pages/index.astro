---
import Layout from '../layouts/Layout.astro';
import SiviezNav from '../components/SiviezNav.astro';
---

<Layout>
  <SiviezNav />
  <section class="hero">

    <div class="center">
      <div class="eyebrow" data-i18n="eyebrow">Valais · Zwitserse Alpen</div>

      <h1>Siviez</h1>
      <div class="altitude" data-i18n="altitude">1730m in de bergen</div>

      <p class="tagline" data-i18n-html="tagline">
        Waar de <em>4 Vallées</em> beginnen. Turquoise meren, oude bisses en 400 km pistes voor de deur.
      </p>

      <div class="info-strip">
        <div class="info-item">
          <div class="info-value">1730</div>
          <div class="info-label" data-i18n="info.altitude">Altitude</div>
        </div>
        <div class="info-item">
          <div class="info-value">410</div>
          <div class="info-label" data-i18n="info.slopes">km pistes</div>
        </div>
        <div class="info-item">
          <div class="info-value">8</div>
          <div class="info-label" data-i18n="info.bisses">Bisses</div>
        </div>
        <div class="info-item">
          <div class="info-value">3336</div>
          <div class="info-label" data-i18n="info.peak">Piek</div>
        </div>
      </div>

      <div class="two-cards">

        <div class="card">
          <div class="card-label" data-i18n="card1.label">Ontdek</div>
          <div class="card-title" data-i18n-html="card1.title">Siviez <em>gids</em></div>
          <div class="card-credit" data-i18n-html="card1.credit">
            Een online reisgids door <a href="https://pupvanh.vercel.app" target="_blank" rel="noopener">PUPVANH Projects</a>
          </div>
          <p class="card-body" data-i18n="card1.body">
            Wandelroutes, ski-info, dorp en lokale tips over Siviez, Nendaz en de 4 Vallées. Volg de bouw van de site op Instagram.
          </p>
          <a href="https://www.instagram.com/siviez" class="card-link" target="_blank" rel="noopener">
            <span data-i18n="card1.cta">Volg @siviez</span>
            <span class="arrow">↗</span>
          </a>
        </div>

        <div class="card">
          <div class="card-label" data-i18n="card2.label">Verblijf</div>
          <div class="card-title">Rosablanche <em>C34</em></div>
          <div class="card-credit" data-i18n="card2.credit">Ski-in / ski-out · Slaapt 7</div>
          <p class="card-body" data-i18n="card2.body">
            Een ruim berg­appartement in het hart van Siviez. Volwaardige slaapkamer, zuidgericht terras, gratis parking en de piste voor de deur.
          </p>
          <a href="/appartement" class="card-link emphasis">
            <span data-i18n="card2.cta">Meer info →</span>
            <span class="arrow">→</span>
          </a>
        </div>

      </div>
    </div>

    <div class="bottom">
      <div class="coming-soon">
        <div class="pulse"></div>
        <span data-i18n="coming">Volledige gids komt eraan</span>
      </div>
      <div class="footer-links">
        <a href="https://www.instagram.com/siviez" target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="18" cy="6" r="1" fill="currentColor" />
          </svg>
          <span>@siviez</span>
        </a>
      </div>
    </div>

  </section>

  <footer>
    <div class="footer-line-1">© 2026 · Hosted by Luc</div>
    <div class="footer-line-2">
      BUILT AUG 2026<span class="dot">·</span>UPDATED AUG 2026<span class="dot">·</span>Siviez.com<span class="dot">·</span>Part of <a href="https://pupvanh.vercel.app" target="_blank" rel="noopener">PUPVANH Projects →</a>
    </div>
  </footer>

  <script is:inline>
    const i18n = {
      nl: {
        "eyebrow": "Valais · Zwitserse Alpen",
        "altitude": "1730m in de bergen",
        "tagline": "Waar de <em>4 Vallées</em> beginnen. Turquoise meren, oude bisses en 400 km pistes voor de deur.",
        "info.altitude": "Altitude",
        "info.slopes": "km pistes",
        "info.bisses": "Bisses",
        "info.peak": "Piek",
        "card1.label": "Ontdek",
        "card1.title": "Siviez <em>gids</em>",
        "card1.credit": "Een online reisgids door <a href='https://pupvanh.vercel.app' target='_blank' rel='noopener'>PUPVANH Projects</a>",
        "card1.body": "Wandelroutes, ski-info, dorp en lokale tips over Siviez, Nendaz en de 4 Vallées. Volg de bouw van de site op Instagram.",
        "card1.cta": "Volg @siviez",
        "card2.label": "Verblijf",
        "card2.credit": "Ski-in / ski-out · Slaapt 7",
        "card2.body": "Een ruim berg­appartement in het hart van Siviez. Volwaardige slaapkamer, zuidgericht terras, gratis parking en de piste voor de deur.",
        "card2.cta": "Meer info →",
        "coming": "Volledige gids komt eraan"
      },
      en: {
        "eyebrow": "Valais · Swiss Alps",
        "altitude": "1730m up in the mountains",
        "tagline": "Where the <em>4 Vallées</em> begin. Turquoise lakes, ancient bisses and 400 km of pistes right outside.",
        "info.altitude": "Altitude",
        "info.slopes": "km slopes",
        "info.bisses": "Bisses",
        "info.peak": "Peak",
        "card1.label": "Discover",
        "card1.title": "Siviez <em>guide</em>",
        "card1.credit": "An online travel guide by <a href='https://pupvanh.vercel.app' target='_blank' rel='noopener'>PUPVANH Projects</a>",
        "card1.body": "Hiking routes, ski info, village and local tips about Siviez, Nendaz and the 4 Vallées. Follow the build on Instagram.",
        "card1.cta": "Follow @siviez",
        "card2.label": "Stay",
        "card2.credit": "Ski-in / ski-out · Sleeps 7",
        "card2.body": "A spacious mountain apartment in the heart of Siviez. A proper bedroom, south-facing terrace, free parking and the slopes at your door.",
        "card2.cta": "Read more →",
        "coming": "Full guide coming soon"
      },
      fr: {
        "eyebrow": "Valais · Alpes suisses",
        "altitude": "1730m en pleine montagne",
        "tagline": "Là où commencent les <em>4 Vallées</em>. Lacs turquoise, bisses centenaires et 400 km de pistes au pas de la porte.",
        "info.altitude": "Altitude",
        "info.slopes": "km de pistes",
        "info.bisses": "Bisses",
        "info.peak": "Sommet",
        "card1.label": "Découvrir",
        "card1.title": "Guide de <em>Siviez</em>",
        "card1.credit": "Un guide en ligne par <a href='https://pupvanh.vercel.app' target='_blank' rel='noopener'>PUPVANH Projects</a>",
        "card1.body": "Randonnées, ski, village et astuces locales sur Siviez, Nendaz et les 4 Vallées. Suivez la construction sur Instagram.",
        "card1.cta": "Suivre @siviez",
        "card2.label": "Séjourner",
        "card2.credit": "Ski aux pieds · Jusqu'à 7 personnes",
        "card2.body": "Un appartement de montagne spacieux au cœur de Siviez. Une vraie chambre, terrasse plein sud, parking gratuit et la piste devant la porte.",
        "card2.cta": "En savoir plus →",
        "coming": "Guide complet en préparation"
      }
    };

    function setLang(lang) {
      document.documentElement.lang = lang;
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (i18n[lang][key]) el.textContent = i18n[lang][key];
      });
      document.querySelectorAll('[data-i18n-html]').forEach(el => {
        const key = el.getAttribute('data-i18n-html');
        if (i18n[lang][key]) el.innerHTML = i18n[lang][key];
      });
      document.querySelectorAll('.lang-toggle button').forEach(b => {
        b.classList.toggle('active', b.dataset.lang === lang);
      });
      try { localStorage.setItem('siviez-lang', lang); } catch(e) {}
    }

    document.querySelectorAll('.lang-toggle button').forEach(b => {
      b.addEventListener('click', () => setLang(b.dataset.lang));
    });

    // Luister ook naar taalwissel events uit SiviezNav
    window.addEventListener('siviez-lang-change', (e) => setLang(e.detail.lang));

    let initial = 'nl';
    try {
      const stored = localStorage.getItem('siviez-lang');
      if (stored && i18n[stored]) initial = stored;
      else {
        const nav = (navigator.language || 'nl').slice(0, 2);
        if (i18n[nav]) initial = nav;
      }
    } catch(e) {}
    setLang(initial);
  </script>
</Layout>
