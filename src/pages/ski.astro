---
// /ski — winter guide: the 4 Vallées ski area, the three lifts from Siviez,
// ski-in/ski-out, and the ESS Nendaz ski school. Trilingual NL/EN/FR.
import Layout from '../layouts/Layout.astro';
import SiviezNav from '../components/SiviezNav.astro';

const pageTitle = 'Skiing in Siviez · 4 Vallées ski-in/ski-out · 410 km of pistes';
const pageDescription = 'Ski-in/ski-out from Rosablanche C34 in Siviez — gateway to the 4 Vallées (410 km of pistes, Mont Fort 3330m). Three lifts from the door, the ESS Nendaz ski school, and everything for a winter week.';

const schema = {
  "@context": "https://schema.org",
  "@type": "SkiResort",
  "name": "Siviez — 4 Vallées ski area",
  "description": "Siviez is the ski-in/ski-out gateway to the 4 Vallées (410 km of pistes), with three lifts leaving from the village towards Veysonnaz/Thyon, Mont-Fort/Verbier and Nendaz.",
  "url": "https://siviez.com/ski",
  "geo": { "@type": "GeoCoordinates", "latitude": 46.13471, "longitude": 7.31674 },
  "containedInPlace": { "@type": "Place", "name": "Nendaz, Valais, Switzerland" }
};
---

<Layout title={pageTitle} description={pageDescription} ogImage="https://siviez.com/photos/ski/siviez-village-winter-snow.avif">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <SiviezNav />

  <section class="hero">
    <div class="hero-inner">
      <div class="kicker" data-i18n="s.kicker">Winter · Valais · 4 Vallées</div>
      <h1>Ski <em data-i18n="s.title.em">Siviez</em></h1>
      <p class="hero-tag" data-i18n="s.tag">Ski-in/ski-out into one of the largest ski areas in the world — 410 km of pistes, straight from the door.</p>
    </div>
  </section>

  <div class="page">

    <!-- STATS -->
    <section class="intro">
      <div class="section-kicker" data-i18n="s.stats.kicker">The 4 Vallées</div>
      <h2 data-i18n="s.stats.title">One ski pass, four valleys</h2>
      <p class="lead-p" data-i18n="s.stats.body">
        Nendaz, Verbier, Veysonnaz and Thyon, all linked by lift. Endless variety, and more terrain than
        you could ski in a week — with Siviez sitting right in the middle of it.
      </p>
      <div class="stats-strip">
        <div class="stat"><div class="sv">410</div><div class="sl" data-i18n="s.stat.km">Km of pistes</div></div>
        <div class="stat"><div class="sv">92</div><div class="sl" data-i18n="s.stat.lifts">Lifts</div></div>
        <div class="stat"><div class="sv">3330</div><div class="sl" data-i18n="s.stat.montfort">Mont Fort (m)</div></div>
        <div class="stat"><div class="sv">4</div><div class="sl" data-i18n="s.stat.valleys">Valleys</div></div>
      </div>
    </section>

    <!-- SKI-IN SKI-OUT -->
    <section class="feature">
      <div class="feature-text">
        <div class="section-kicker" data-i18n="s.door.kicker">The advantage</div>
        <h2 data-i18n="s.door.title">Ski-in, ski-out</h2>
        <p data-i18n="s.door.p1">
          Rosablanche C34 sits at the foot of the slopes, right by the Siviez lift station. Boot up in the
          apartment's ski room, walk out, click in, and go — no shuttle, no long walk in ski boots.
        </p>
        <p data-i18n="s.door.p2">
          At the end of the day you ski back to the front of the building. Warm up on the terrace, dry your
          boots overnight in the locked ski room downstairs, and do it again tomorrow.
        </p>
      </div>
      <div class="feature-img">
        <img src="/photos/ski/rosablanche-c34-aerial-summer.jpg" alt="Rosablanche C34 apartment complex at the foot of the slopes in Siviez, with the ski lift" loading="lazy" />
      </div>
    </section>

    <!-- THE THREE LIFTS -->
    <section class="lifts">
      <div class="section-kicker" data-i18n="s.lifts.kicker">From the door</div>
      <h2 data-i18n="s.lifts.title">Three lifts, three directions</h2>
      <p class="lifts-intro" data-i18n="s.lifts.intro">
        Siviez is a real hub: three lifts leave from the village, each opening a different part of the
        4 Vallées. That's what ski-in/ski-out really means here — you can head three ways from your doorstep.
      </p>

      <div class="lifts-grid">
        <article class="lift-card">
          <div class="lift-badge" data-i18n="s.lift.comb.badge">Chairlift</div>
          <h3 data-i18n="s.lift.comb.name">Combatseline</h3>
          <p class="lift-to" data-i18n="s.lift.comb.to">→ Veysonnaz / Thyon</p>
          <p data-i18n="s.lift.comb.body">The 4-seater up to Combatseline (2238m), opening the Veysonnaz and Thyon side of the area — long, sunny cruising pistes.</p>
        </article>

        <article class="lift-card">
          <div class="lift-badge" data-i18n="s.lift.tortin.badge">Chairlift</div>
          <h3 data-i18n="s.lift.tortin.name">Tortin</h3>
          <p class="lift-to" data-i18n="s.lift.tortin.to">→ Mont-Fort / Verbier</p>
          <p data-i18n="s.lift.tortin.body">Towards Tortin and the Col des Gentianes, gateway to Mont-Fort (3330m) — the high point of the 4 Vallées — and on to Verbier.</p>
        </article>

        <article class="lift-card">
          <div class="lift-badge" data-i18n="s.lift.plandufou.badge">Gondola</div>
          <h3 data-i18n="s.lift.plandufou.name">Siviez–Plan du Fou</h3>
          <p class="lift-to" data-i18n="s.lift.plandufou.to">→ Nendaz</p>
          <p data-i18n="s.lift.plandufou.body">The 8-seater gondola to Plan du Fou, linking towards Nendaz, Tracouet and Prarion — no change needed towards Nendaz.</p>
        </article>
      </div>
    </section>

    <!-- SKI SCHOOL -->
    <section class="school-section">
      <div class="section-kicker" data-i18n="s.school.kicker">Lessons</div>
      <h2 data-i18n="s.school.title">Ski school on the doorstep</h2>
      <div class="school-body">
        <div class="school-text">
          <h3 data-i18n="s.school.name">ESS Nendaz — Swiss Ski School</h3>
          <p data-i18n="s.school.p1">
            The official Swiss Ski School (ESS) has been running for over 50 years, and its Siviez desk is
            right in the Rosablanche building — the same block as the apartment. So booking a lesson is
            quite literally a floor away.
          </p>
          <p data-i18n="s.school.p2">
            Group and private lessons for ski, snowboard, télémark and cross-country; children from age 3;
            plus ski touring and off-piste. In winter the Siviez desk is open daily 9:00–17:00 (continuous
            in high season).
          </p>
          <div class="school-meta">
            <span class="pill" data-i18n="s.school.p.group">Group & private</span>
            <span class="pill" data-i18n="s.school.p.kids">Kids from 3</span>
            <span class="pill" data-i18n="s.school.p.board">Ski · snowboard · télémark</span>
            <span class="pill" data-i18n="s.school.p.touring">Off-piste & touring</span>
          </div>
          <a href="https://skinendaz.ch/" target="_blank" rel="noopener" class="school-link" data-track="ski_ess_nendaz" data-i18n="s.school.link">skinendaz.ch ↗</a>
        </div>
      </div>
    </section>

    <!-- ROADMAP -->
    <section class="roadmap">
      <div class="section-kicker" data-i18n="s.more.kicker">More coming</div>
      <h2 data-i18n="s.more.title">A full winter guide, this season</h2>
      <p class="roadmap-intro" data-i18n="s.more.intro">
        Detailed winter guides are being added through the season — piste maps, the routes locals actually
        take, and where to eat on the mountain.
      </p>
      <ul class="roadmap-list">
        <li data-i18n="s.more.1">Ski-in / ski-out from C34 — the morning routine</li>
        <li data-i18n="s.more.2">Mont Fort at 3330m — the big off-piste descent</li>
        <li data-i18n="s.more.3">Beginner's guide — the easy pistes near Siviez</li>
        <li data-i18n="s.more.4">A family day plan — where the kids go, where you rest</li>
        <li data-i18n="s.more.5">Après-ski in Siviez — where the locals go</li>
        <li data-i18n="s.more.6">Weather & snow reports — the best sources</li>
      </ul>
    </section>

    <!-- CTA -->
    <section class="cta">
      <h2 data-i18n="s.cta.title">Stay at the foot of the slopes</h2>
      <p data-i18n="s.cta.body">Rosablanche C34 is ski-in/ski-out, with a ski room, the ski school desk and a café all in the same building.</p>
      <div class="cta-buttons">
        <a href="/appartement" class="btn btn-primary" data-track="ski_to_apartment" data-i18n="s.cta.stay">See the apartment →</a>
        <a href="/discover/village" class="btn btn-ghost" data-i18n="s.cta.village">Discover the village</a>
      </div>
    </section>

    <footer>
      <span>© 2026 · Hosted by Luc</span>
      <span class="dot">·</span>
      <span>Part of <a href="https://pupvanh.vercel.app" target="_blank" rel="noopener">PUPVANH Projects →</a></span>
    </footer>

  </div>
</Layout>

<style>
  .hero {
    position: relative; min-height: 80vh; display: flex; align-items: flex-end;
    padding: 120px 24px 60px; color: #F4F0E8;
    background:
      linear-gradient(180deg, rgba(15,38,34,0.4) 0%, rgba(15,38,34,0.25) 35%, rgba(15,38,34,0.85) 100%),
      url('/photos/ski/siviez-village-winter-snow.avif') center 50% / cover no-repeat;
  }
  .hero-inner { max-width: 1100px; margin: 0 auto; width: 100%; }
  .kicker { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: #C8A35F; margin-bottom: 18px; }
  h1 { font-family: 'Playfair Display', serif; font-weight: 400; font-size: clamp(52px, 9vw, 112px); line-height: 0.98; letter-spacing: -0.02em; margin: 0 0 18px 0; }
  h1 em { font-style: italic; color: #C8A35F; }
  .hero-tag { font-family: 'Playfair Display', serif; font-style: italic; font-size: clamp(17px, 2.6vw, 24px); color: rgba(244,240,232,0.92); max-width: 640px; }

  .page { background: #0F2622; color: #F4F0E8; }
  section { max-width: 1100px; margin: 0 auto; padding: 72px 24px; }

  .section-kicker { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: #C8A35F; margin-bottom: 16px; }
  h2 { font-family: 'Playfair Display', serif; font-weight: 400; font-size: clamp(30px, 4.5vw, 52px); line-height: 1.05; letter-spacing: -0.015em; margin-bottom: 22px; }
  h2 em { font-style: italic; color: #C8A35F; }
  p { font-size: 17px; line-height: 1.75; color: rgba(244,240,232,0.82); margin-bottom: 18px; }

  .intro { border-bottom: 1px solid rgba(200,163,95,0.15); }
  .lead-p { max-width: 680px; }
  .stats-strip {
    display: flex; flex-wrap: wrap; gap: 0; justify-content: space-between;
    background: rgba(30,58,52,0.5); border: 1px solid rgba(200,163,95,0.2);
    border-radius: 10px; padding: 28px 20px; margin-top: 32px;
  }
  .stats-strip .stat { flex: 1; min-width: 90px; text-align: center; padding: 4px 8px; }
  .stats-strip .sv { font-family: 'Playfair Display', serif; font-size: clamp(28px, 4vw, 44px); color: #C8A35F; line-height: 1; }
  .stats-strip .sl { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: rgba(244,240,232,0.6); margin-top: 10px; }

  .feature { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; border-bottom: 1px solid rgba(200,163,95,0.15); }
  .feature-img { height: 440px; border-radius: 8px; overflow: hidden; }
  .feature-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s ease; }
  .feature:hover .feature-img img { transform: scale(1.04); }
  .feature-text p:last-of-type { margin-bottom: 0; }

  .lifts { border-bottom: 1px solid rgba(200,163,95,0.15); }
  .lifts-intro { max-width: 680px; margin-bottom: 36px; }
  .lifts-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .lift-card { background: rgba(30,58,52,0.5); border: 1px solid rgba(200,163,95,0.2); border-radius: 8px; padding: 28px 24px; }
  .lift-badge { display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 1.5px; text-transform: uppercase; color: #1E3A34; background: #C8A35F; padding: 4px 10px; border-radius: 2px; margin-bottom: 16px; }
  .lift-card h3 { font-family: 'Playfair Display', serif; font-weight: 400; font-size: 26px; color: #F4F0E8; margin-bottom: 4px; }
  .lift-to { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #C8A35F; margin-bottom: 14px; }
  .lift-card p:last-child { font-size: 14px; line-height: 1.6; margin: 0; }

  .school-section { border-bottom: 1px solid rgba(200,163,95,0.15); }
  .school-body { max-width: 760px; }
  .school-text h3 { font-family: 'Playfair Display', serif; font-weight: 400; font-size: 28px; color: #F4F0E8; margin-bottom: 16px; }
  .school-meta { display: flex; flex-wrap: wrap; gap: 6px; margin: 18px 0; }
  .pill { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #C8A35F; background: rgba(200,163,95,0.12); border: 1px solid rgba(200,163,95,0.25); padding: 4px 10px; border-radius: 999px; }
  .school-link { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 1px; color: #C8A35F; text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.2s ease; }
  .school-link:hover { border-bottom-color: #C8A35F; }

  .tip { background: rgba(232,93,47,0.10); border-left: 3px solid #E85D2F; border-radius: 4px; padding: 16px 20px; }
  .tip-label { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: #E85D2F; }
  .tip p { font-size: 15px; margin: 6px 0 0 0; color: rgba(244,240,232,0.9); }

  .roadmap { border-bottom: 1px solid rgba(200,163,95,0.15); }
  .roadmap-intro { max-width: 680px; margin-bottom: 28px; }
  .roadmap-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; max-width: 900px; }
  .roadmap-list li { display: flex; gap: 14px; align-items: baseline; padding: 16px 20px; background: rgba(30,58,52,0.5); border-left: 2px solid #E85D2F; font-family: 'Playfair Display', serif; font-style: italic; font-size: 16px; color: #F4F0E8; }
  .roadmap-list li::before { content: "→"; color: #E85D2F; font-family: 'JetBrains Mono', monospace; font-size: 13px; font-style: normal; flex-shrink: 0; }

  .cta { text-align: center; }
  .cta p { max-width: 600px; margin: 0 auto 32px; }
  .cta-buttons { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .btn { display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; padding: 15px 28px; border-radius: 999px; text-decoration: none; transition: all 0.25s ease; }
  .btn-primary { background: #E85D2F; color: #F4F0E8; }
  .btn-primary:hover { background: #C8A35F; color: #1E3A34; transform: translateY(-2px); }
  .btn-ghost { border: 1px solid rgba(244,240,232,0.3); color: #F4F0E8; }
  .btn-ghost:hover { border-color: #C8A35F; color: #C8A35F; }

  footer { max-width: 100%; text-align: center; padding: 40px 24px; border-top: 1px solid rgba(200,163,95,0.1); font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(244,240,232,0.5); }
  footer .dot { color: #E85D2F; margin: 0 8px; }
  footer a { color: #C8A35F; text-decoration: none; }

  @media (max-width: 900px) {
    .lifts-grid { grid-template-columns: 1fr; }
    .school-body { grid-template-columns: 1fr; gap: 28px; }
    .roadmap-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 820px) {
    .feature { grid-template-columns: 1fr; gap: 32px; }
    .feature-img { height: 300px; order: -1; }
    section { padding: 56px 20px; }
    .hero { min-height: 58vh; }
  }
</style>

