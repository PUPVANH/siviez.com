  function setLang(lang) {
    const dict = translations[lang] || translations.en;
    document.querySelectorAll('[data-i18n]').forEach(function(el) {
      const key = el.getAttribute('data-i18n');
      if (dict[key]) el.textContent = dict[key];
    });
    try { localStorage.setItem('siviez-lang', lang); } catch(e){}
  }
  window.addEventListener('siviez-lang-change', function(e) { setLang(e.detail.lang); });
  let initial = 'en';
  try {
    const stored = localStorage.getItem('siviez-lang');
    if (stored) initial = stored;
    else if (navigator.language) { const b = navigator.language.slice(0,2); if (translations[b]) initial = b; }
  } catch(e) {}
  setLang(initial);
