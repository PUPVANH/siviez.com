---
import Analytics from '@vercel/analytics/astro';
import SiviezNav from '../components/SiviezNav.astro';
---
<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Skiing in Siviez · 4 Vallées ski area · siviez.com</title>
<meta name="description" content="Ski-in/ski-out from Rosablanche C34 in Siviez — the gateway to 4 Vallées (410 km of pistes). Ski schools, Mont Fort, and everything you need for a winter week.">
<link rel="canonical" href="https://siviez.com/ski">
<link rel="icon" type="image/svg+xml" href="/favicons/siviez.svg">

<meta property="og:type" content="website">
<meta property="og:title" content="Skiing in Siviez · 4 Vallées ski area">
<meta property="og:description" content="Ski-in/ski-out in one of the largest ski areas in the world. 410 km of pistes, direct from Rosablanche C34.">
<meta property="og:image" content="https://siviez.com/Siviez/siviez-winter.avif">
<meta property="og:url" content="https://siviez.com/ski">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,600&family=Caveat:wght@500;600&display=swap" rel="stylesheet">

<style>
  :root {
    --teal:#0E6B6F; --gold:#C8A35F; --ember:#E85D2F;
    --ivory:#F4F0E8; --forest:#1E3A34; --paper:#FAF7F0;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  body {
    font-family:'Inter', sans-serif; font-weight:300; line-height:1.65;
    color:var(--ivory); background:var(--forest);
    -webkit-font-smoothing:antialiased;
  }

  .hero {
    position:relative; min-height:100vh; overflow:hidden;
    display:flex; flex-direction:column; justify-content:flex-end;
    padding:120px 40px 80px;
    background:
      linear-gradient(180deg, rgba(15,38,34,0.4) 0%, rgba(15,38,34,0.2) 30%, rgba(15,38,34,0.6) 70%, rgba(15,38,34,0.95) 100%),
      url('/Siviez/siviez-winter.avif') center 40%/cover no-repeat;
  }
  .hero-inner { max-width:1200px; margin:0 auto; width:100%; }
  .hero-kicker {
    font-family:'JetBrains Mono',monospace; font-size:11px;
    letter-spacing:3px; text-transform:uppercase; color:var(--gold);
    margin-bottom:24px;
  }
  h1 {
    font-family:'Playfair Display',serif; font-weight:400;
    font-size:clamp(64px,10vw,140px); line-height:0.95; letter-spacing:-0.02em;
    margin-bottom:32px;
  }
  h1 em { font-style:italic; color:var(--gold); }
  .hero-lede {
    max-width:640px; font-size:19px; line-height:1.6;
    color:rgba(244,240,232,.88); margin-bottom:40px;
  }
  .hero-lede em { color:var(--gold); font-style:italic; }
  .scroll-hint {
    font-family:'JetBrains Mono',monospace; font-size:10px;
    letter-spacing:3px; text-transform:uppercase; color:rgba(244,240,232,0.55);
  }

  section { padding:120px 40px; position:relative; }
  .container { max-width:1200px; margin:0 auto; }

  .kicker {
    font-family:'JetBrains Mono',monospace; font-size:11px;
    letter-spacing:3px; text-transform:uppercase; color:var(--gold);
    margin-bottom:20px;
  }
  h2 {
    font-family:'Playfair Display',serif; font-weight:400;
    font-size:clamp(38px,5.5vw,64px); line-height:1.05; letter-spacing:-0.015em;
    margin-bottom:24px;
  }
  h2 em { font-style:italic; color:var(--gold); }
  p { font-size:17px; line-height:1.7; color:rgba(244,240,232,0.82); margin-bottom:16px; max-width:680px; }
  p em { color:var(--gold); font-style:italic; }

  /* STATS - 4 Vallées numbers */
  .stats {
    display:grid; grid-template-columns:repeat(4,1fr); gap:32px;
    margin:60px 0;
    padding:40px 0;
    border-top:1px solid rgba(200,163,95,0.25);
    border-bottom:1px solid rgba(200,163,95,0.25);
  }
  .stat .stat-value {
    font-family:'Playfair Display',serif; font-weight:400;
    font-size:clamp(48px,6vw,72px); color:var(--gold);
    line-height:1;
  }
  .stat .stat-label {
    font-family:'JetBrains Mono',monospace; font-size:10px;
    letter-spacing:2px; text-transform:uppercase; color:rgba(244,240,232,0.6);
    margin-top:12px;
  }

  /* FEATURED - ski-in ski-out */
  .featured {
    display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center;
    padding:120px 40px;
    max-width:1400px; margin:0 auto;
  }
  .featured-image {
    position:relative; height:600px; overflow:hidden; border-radius:4px;
  }
  .featured-image img {
    width:100%; height:100%; object-fit:cover;
    transition:transform 1.2s ease;
  }
  .featured:hover .featured-image img { transform:scale(1.04); }
  .featured-tag {
    display:inline-block;
    font-family:'JetBrains Mono',monospace; font-size:10px;
    letter-spacing:2px; text-transform:uppercase; color:var(--forest);
    background:var(--gold); padding:6px 12px; border-radius:2px;
    margin-bottom:20px;
  }

  /* SCHOOLS */
  .schools-section {
    background:rgba(30,58,52,0.5);
    padding:120px 40px;
  }
  .schools {
    display:grid; grid-template-columns:repeat(2,1fr); gap:32px;
    margin-top:60px;
  }
  .school {
    padding:40px;
    background:rgba(15,38,34,0.5);
    border:1px solid rgba(200,163,95,0.2);
    border-radius:4px;
  }
  .school-name {
    font-family:'Playfair Display',serif; font-size:26px;
    color:var(--ivory); margin-bottom:8px;
    font-weight:400;
  }
  .school-name em { font-style:italic; color:var(--gold); }
  .school-tag {
    font-family:'JetBrains Mono',monospace; font-size:10px;
    letter-spacing:2px; text-transform:uppercase; color:var(--gold);
    margin-bottom:20px;
  }
  .school p {
    font-size:14px; margin-bottom:16px;
  }
  .school ul {
    list-style:none; padding:0; margin:20px 0 0;
    display:flex; flex-direction:column; gap:10px;
  }
  .school ul li {
    font-size:13px; padding-left:20px; position:relative;
    color:rgba(244,240,232,0.78);
  }
  .school ul li::before {
    content:"✓"; position:absolute; left:0; color:var(--ember);
    font-family:'JetBrains Mono',monospace;
  }

  /* ROADMAP */
  .roadmap {
    background:var(--forest);
    padding:120px 40px 80px;
    border-top:1px solid rgba(200,163,95,0.15);
  }
  .roadmap ul {
    list-style:none; padding:0; margin:40px 0 0;
    display:grid; grid-template-columns:repeat(2,1fr); gap:16px;
    max-width:900px;
  }
  .roadmap li {
    display:flex; gap:16px; align-items:baseline;
    padding:20px 24px;
    background:rgba(30,58,52,0.5);
    border-left:2px solid var(--ember);
    font-family:'Playfair Display',serif; font-style:italic;
    font-size:17px; color:var(--ivory);
  }
  .roadmap li::before {
    content:"→"; color:var(--ember); font-family:'JetBrains Mono',monospace;
    font-size:13px; font-style:normal; flex-shrink:0;
  }
  .roadmap li strong { font-weight:500; color:var(--gold); font-style:normal; }

  .signature {
    font-family:'Caveat', cursive; font-size:32px; color:var(--gold);
    margin:60px 0 40px;
    display:block;
  }

  .cta-row {
    display:flex; gap:16px; flex-wrap:wrap;
    margin-top:40px;
  }
  .btn {
    display:inline-flex; align-items:center; gap:8px;
    font-family:'JetBrains Mono',monospace; font-size:11px;
    letter-spacing:1.5px; text-transform:uppercase;
    padding:16px 28px; border-radius:999px; text-decoration:none;
    transition:all 0.2s ease;
  }
  .btn-primary { background:var(--ember); color:var(--ivory); }
  .btn-primary:hover { background:var(--gold); color:var(--forest); transform:translateY(-2px); }
  .btn-ghost { background:transparent; color:var(--ivory); border:1px solid rgba(244,240,232,0.3); }
  .btn-ghost:hover { border-color:var(--gold); color:var(--gold); }

  footer {
    background:#0F2622; padding:60px 32px; text-align:center;
    font-family:'JetBrains Mono',monospace; font-size:10px;
    letter-spacing:1.5px; text-transform:uppercase; color:rgba(244,240,232,0.5);
    border-top:1px solid rgba(200,163,95,0.1);
  }
  footer .dot { color:var(--ember); margin:0 6px; }
  footer a { color:var(--gold); text-decoration:none; }
  footer a:hover { color:var(--ivory); }

  @media (max-width:900px) {
    .featured { grid-template-columns:1fr; gap:40px; padding:80px 20px; }
    .featured-image { height:400px; order:-1; }
    .stats { grid-template-columns:repeat(2,1fr); gap:24px; }
    .schools { grid-template-columns:1fr; }
    .roadmap ul { grid-template-columns:1fr; }
    section, .schools-section, .roadmap { padding:80px 20px; }
    .hero { padding:100px 20px 60px; }
  }
</style>
<Analytics />
</head>
<body>

<SiviezNav />

<section class="hero">
  <div class="hero-inner">
    <div class="hero-kicker">Winter · Valais · 4 Vallées</div>
    <h1>Ski <em>the</em> 4 Vallées.</h1>
    <p class="hero-lede">
      One of the largest ski areas in the world starts at your doorstep. <em>410 km</em> of pistes,
      ski-in/ski-out from Rosablanche C34, and the mighty <em>Mont Fort</em> at 3330m for the brave.
    </p>
    <div class="scroll-hint">Scroll ↓</div>
  </div>
</section>

<!-- STATS -->
<section>
  <div class="container">
    <div class="kicker">The 4 Vallées</div>
    <h2>One ski pass, <em>four valleys</em>.</h2>
    <p>
      Nendaz, Verbier, Veysonnaz, Thyon. Connected by lifts, endless variety, and enough terrain
      that even a full week won't cover it all.
    </p>

    <div class="stats">
      <div class="stat">
        <div class="stat-value">410</div>
        <div class="stat-label">km of pistes</div>
      </div>
      <div class="stat">
        <div class="stat-value">92</div>
        <div class="stat-label">lifts</div>
      </div>
      <div class="stat">
        <div class="stat-value">3330</div>
        <div class="stat-label">Mont Fort — meters</div>
      </div>
      <div class="stat">
        <div class="stat-value">100</div>
        <div class="stat-label">off-piste routes</div>
      </div>
    </div>
  </div>
</section>

<!-- FEATURED: Ski-in ski-out -->
<section style="padding:0;">
  <div class="featured">
    <div class="featured-image">
      <img src="/Siviez/rosablanche-2.jpg" alt="Rosablanche C34 apartment complex with ski lift and mountains" loading="lazy">
    </div>
    <div>
      <span class="featured-tag">The advantage</span>
      <div class="kicker">Right at the door</div>
      <h2>Ski-in, <em>ski-out</em>.</h2>
      <p>
        Rosablanche C34 sits directly at the foot of the Combatselina chairlift.
        Boot up in the apartment's ski room, walk out the door, click in, and go.
        No shuttles, no long walks with heavy boots — just <em>doorstep to piste</em> in under two minutes.
      </p>
      <p>
        End of the day? Ski back down to the front of the building. Warm shower, fondue on the terrace,
        boots dry overnight in the locked ski room downstairs.
      </p>
    </div>
  </div>
</section>

<!-- SCHOOLS -->
<section class="schools-section">
  <div class="container">
    <div class="kicker">First time or first ski week?</div>
    <h2>Two ski schools <em>on site</em>.</h2>
    <p>Both are within a 5-minute walk of Rosablanche C34, both offer group and private lessons in Dutch, English and French. Here's the difference:</p>

    <div class="schools">
      <div class="school">
        <div class="school-tag">Established · Local</div>
        <div class="school-name">Neige <em>Adventure</em></div>
        <p>The bigger of the two — established local school, wide range of instructors, and their own ski shop attached. Popular with families.</p>
        <ul>
          <li>Group lessons for all levels</li>
          <li>Private instruction on demand</li>
          <li>Kids' Piou-Piou club (3-6 years)</li>
          <li>Ski + snowboard rental on site</li>
        </ul>
      </div>

      <div class="school">
        <div class="school-tag">Smaller · Personal</div>
        <div class="school-name">ESI <em>Arc en Ciel</em></div>
        <p>Smaller and more intimate — often the choice for people who want a more personalised experience or smaller group sizes.</p>
        <ul>
          <li>Small group lessons (max 6)</li>
          <li>Personalised private lessons</li>
          <li>Off-piste and freeride guides</li>
          <li>Multilingual instructors</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ROADMAP -->
<section class="roadmap">
  <div class="container">
    <div class="kicker">More coming</div>
    <h2>Full winter guide <em>this season</em>.</h2>
    <p>Complete ski guides being added throughout winter 2026 — with piste maps, lift access tips, and the routes locals actually take.</p>

    <ul>
      <li><strong>Ski-in / ski-out from C34</strong> — step-by-step morning route</li>
      <li><strong>Mont Fort at 3330m</strong> — the ultimate off-piste descent</li>
      <li><strong>Beginner's guide</strong> — easy pistes near Siviez</li>
      <li><strong>Family day plan</strong> — where the kids go, where you can rest</li>
      <li><strong>Après-ski in Siviez</strong> — where the locals go</li>
      <li><strong>Weather & snow reports</strong> — best sources and timing</li>
    </ul>

    <div class="signature">See you on the slopes.</div>

    <div class="cta-row">
      <a href="https://www.instagram.com/siviez" target="_blank" rel="noopener" class="btn btn-primary">
        <span>Follow @siviez ↗</span>
      </a>
      <a href="/appartement" class="btn btn-ghost">
        <span>Book Rosablanche C34 →</span>
      </a>
    </div>
  </div>
</section>

<footer>
  © 2026 · Hosted by Luc<span class="dot">·</span>Part of <a href="https://pupvanh.vercel.app" target="_blank" rel="noopener">PUPVANH Projects →</a>
</footer>

<script is:inline>
  window.addEventListener('siviez-lang-change', function(e) {
    // Placeholder for future NL/EN/FR content
  });
</script>

</body>
</html>
