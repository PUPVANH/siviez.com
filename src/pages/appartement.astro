---
import Analytics from '@vercel/analytics/astro';
import SiviezNav from '../components/SiviezNav.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rosablanche C34 · Ski-in/ski-out apartment Siviez · 4 Vallées</title>
<meta name="description" content="Spacious ski-in/ski-out mountain apartment for 7 in Siviez, at the heart of the 4 Vallées ski area (410 km of pistes). South-facing terrace, free parking. Book on Airbnb.">
<link rel="canonical" href="https://siviez.com/appartement">
<link rel="icon" type="image/svg+xml" href="/favicons/siviez.svg">

<meta property="og:type" content="website">
<meta property="og:title" content="Rosablanche C34 · Ski-in apartment in Siviez">
<meta property="og:description" content="Spacious mountain apartment for 7 in the heart of the 4 Vallées ski area. Ski-in/ski-out. Book via Airbnb.">
<meta property="og:image" content="https://siviez.com/Siviez/IMG_1791.jpg">
<meta property="og:url" content="https://siviez.com/appartement">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "VacationRental",
  "name": "Rosablanche C34 — Ski-in/ski-out apartment in Siviez",
  "description": "Spacious mountain apartment for up to 7 in Siviez, Valais, Switzerland. Ski-in/ski-out access to the 4 Vallées ski area (410 km of pistes).",
  "url": "https://siviez.com/appartement",
  "image": ["https://siviez.com/Siviez/IMG_1791.jpg","https://siviez.com/Siviez/IMG_1797.jpg","https://siviez.com/Siviez/IMG_1625.jpg"],
  "address": {"@type": "PostalAddress","addressLocality": "Siviez","addressRegion": "Valais","postalCode": "1997","addressCountry": "CH"},
  "geo": {"@type": "GeoCoordinates","latitude": 46.13471,"longitude": 7.31674},
  "numberOfRooms": 1,
  "occupancy": {"@type": "QuantitativeValue","maxValue": 7},
  "aggregateRating": {"@type": "AggregateRating","ratingValue": "4.81","reviewCount": 37,"bestRating": "5"},
  "potentialAction": {"@type": "ReserveAction","target": "https://www.airbnb.com/rooms/10012437","name": "Book on Airbnb"}
}
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&display=swap" rel="stylesheet">
<Analytics />
</head>
<body>
  <div class="siviez-page">

    <SiviezNav />

    <a href="https://www.airbnb.com/rooms/10012437?utm_source=siviez.com&utm_medium=web&utm_campaign=floating_widget" target="_blank" rel="noopener" data-track="airbnb_float" class="sv-float" id="svFloat">
      <span data-i18n="cta.short">Book on Airbnb</span>
    </a>

    <section class="sv-hero">
      <div class="sv-hero-bg" id="svHeroBg"></div>
      <div class="sv-hero-content">
        <div class="sv-hero-kicker" data-i18n="hero.kicker">Siviez · Valais · Swiss Alps · 1730m</div>
        <h1 class="sv-hero-title" data-i18n="hero.title">Rosablanche <em>C34</em></h1>
        <p class="sv-hero-sub" data-i18n="hero.sub">A spacious mountain apartment for up to 7, in the heart of the 4 Vallées ski area. Ski-in / ski-out in winter, endless hiking in summer.</p>
        <div class="sv-hero-actions">
          <a href="https://www.airbnb.com/rooms/10012437?utm_source=siviez.com&utm_medium=web&utm_campaign=hero_button" target="_blank" rel="noopener" data-track="airbnb_hero" class="sv-btn sv-btn-primary" data-i18n="cta.hero">Book on Airbnb</a>
          <a href="#about" class="sv-btn sv-btn-ghost" data-i18n="cta.explore">Explore the place</a>
        </div>
      </div>
      <div class="sv-scroll-hint" data-i18n="scroll">Scroll</div>
    </section>

    <div class="sv-facts">
      <div class="sv-fact"><div class="sv-fact-value">7</div><div class="sv-fact-label" data-i18n="fact.guests">Guests</div></div>
      <div class="sv-fact"><div class="sv-fact-value">6</div><div class="sv-fact-label" data-i18n="fact.beds">Beds</div></div>
      <div class="sv-fact"><div class="sv-fact-value">2</div><div class="sv-fact-label" data-i18n="fact.baths">Bathrooms</div></div>
      <div class="sv-fact"><div class="sv-fact-value">410</div><div class="sv-fact-label" data-i18n="fact.slopes">km of slopes</div></div>
      <div class="sv-fact"><div class="sv-fact-value">4.81</div><div class="sv-fact-label" data-i18n="fact.rating">★ Rating</div></div>
    </div>

    <div class="sv-marquee">
      <div class="sv-marquee-track">
        <span class="sv-marquee-item">Ski in, ski out</span>
        <span class="sv-marquee-item">Bisses de Nendaz</span>
        <span class="sv-marquee-item">4 Vallées</span>
        <span class="sv-marquee-item">Alpine mornings</span>
        <span class="sv-marquee-item">Fondue nights</span>
        <span class="sv-marquee-item">Free parking</span>
        <span class="sv-marquee-item">Ski in, ski out</span>
        <span class="sv-marquee-item">Bisses de Nendaz</span>
        <span class="sv-marquee-item">4 Vallées</span>
        <span class="sv-marquee-item">Alpine mornings</span>
        <span class="sv-marquee-item">Fondue nights</span>
        <span class="sv-marquee-item">Free parking</span>
      </div>
    </div>

    <section id="about" class="sv-section">
      <div class="sv-container">
        <div class="sv-reveal">
          <div class="sv-kicker" data-i18n="about.kicker">The place</div>
          <h2 class="sv-title" data-i18n="about.title">A base camp in the <em>Swiss Alps</em>.</h2>
          <p class="sv-lead" data-i18n="about.lead">Rosablanche C34 sits at 1730 metres in Siviez, a small alpine hamlet tucked between Nendaz and Verbier. Downstairs: the lifts of the 4 Vallées, one of the largest ski areas in the world. Around the corner: eight bisses, dozens of hikes, and quiet mountain valleys most tourists never see.</p>
        </div>

        <div class="sv-intro-grid">
          <div class="sv-season sv-season-winter sv-reveal">
            <div class="sv-season-content">
              <span class="sv-season-badge" data-i18n="winter.badge">Dec — Apr</span>
              <div class="sv-season-label" data-i18n="winter.label">Winter season</div>
              <h3 class="sv-season-title" data-i18n="winter.title">Ski in, ski out.</h3>
              <p class="sv-season-desc" data-i18n="winter.desc">Step out the door onto the slopes of Verbier / 4 Vallées — 410 km of pistes, two ski schools right on site (Neige Adventure & ESI Arc en Ciel), and a locked ski room in the basement.</p>
            </div>
          </div>

          <div class="sv-season sv-season-summer sv-reveal">
            <div class="sv-season-content">
              <span class="sv-season-badge" data-i18n="summer.badge">Jun — Sep</span>
              <div class="sv-season-label" data-i18n="summer.label">Summer season</div>
              <h3 class="sv-season-title" data-i18n="summer.title">Trails from the door.</h3>
              <p class="sv-season-desc" data-i18n="summer.desc">Eight of the famous bisses de Nendaz start nearby, plus alpine lakes, high mountain hikes, and mountain-bike trails through the Val de Nendaz.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sv-section sv-section-warm">
      <div class="sv-container">
        <div class="sv-split">
          <div class="sv-split-image sv-reveal">
            <img src="/Siviez/IMG_7608.jpg" alt="Siviez village view" loading="lazy" />
          </div>
          <div class="sv-split-content sv-reveal">
            <div class="sv-kicker" data-i18n="inside.kicker">The apartment</div>
            <h3 class="sv-split-title" data-i18n="inside.title">Room for the whole crew.</h3>
            <p class="sv-split-p" data-i18n="inside.p1">A spacious apartment for up to 7 people, with a fully equipped kitchen, a south-facing terrace looking over the mountains, and two bathrooms. Perfect for families, groups of friends, or a mixed ski/hike week.</p>
            <ul class="sv-features">
              <li><span class="sv-fi">01</span><span data-i18n="inside.f1">1 bedroom · 6 beds · 2 sofa beds in the living room</span></li>
              <li><span class="sv-fi">02</span><span data-i18n="inside.f2">Fully equipped kitchen incl. raclette & fondue set</span></li>
              <li><span class="sv-fi">03</span><span data-i18n="inside.f3">South-facing terrace with mountain views</span></li>
              <li><span class="sv-fi">04</span><span data-i18n="inside.f4">Free parking · Wi-Fi · Elevator · Ski storage</span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="sv-section">
      <div class="sv-container">
        <div class="sv-split">
          <div class="sv-split-content sv-reveal">
            <div class="sv-kicker" data-i18n="summer2.kicker">Summer tips</div>
            <h3 class="sv-split-title" data-i18n="summer2.title">Where locals actually walk.</h3>
            <p class="sv-split-p" data-i18n="summer2.p1">The bisses are old irrigation channels turned into gentle, almost flat hiking paths — perfect for a slow morning with kids or coffee-in-hand. For something bigger, the Cleuson dam and the high valleys above Siviez open up into serious alpine terrain.</p>
            <ul class="sv-features">
              <li><span class="sv-fi">➜</span><span data-i18n="summer2.f1">Bisse du Milieu — easy, shaded, 2h loop from Haute-Nendaz</span></li>
              <li><span class="sv-fi">➜</span><span data-i18n="summer2.f2">Lac de Cleuson — turquoise reservoir, 45 min drive up</span></li>
              <li><span class="sv-fi">➜</span><span data-i18n="summer2.f3">Col des Gentianes — cable car to 2950m, panoramic</span></li>
              <li><span class="sv-fi">➜</span><span data-i18n="summer2.f4">Mountain biking — dedicated trails through Val de Nendaz</span></li>
            </ul>
          </div>
          <div class="sv-split-image sv-reveal">
            <img src="/Siviez/IMG_1797.jpg" alt="Alpine valley hike near Siviez" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <section class="sv-section sv-section-ivory">
      <div class="sv-container">
        <div class="sv-reveal">
          <div class="sv-kicker" data-i18n="gallery.kicker">Around Siviez</div>
          <h2 class="sv-title" data-i18n="gallery.title">Turquoise lakes, quiet <em>valleys</em>, high air.</h2>
        </div>
        <div class="sv-gallery sv-reveal">
          <div class="sv-g sv-g-1"><img src="/Siviez/IMG_1625.jpg" alt="" loading="lazy" /></div>
          <div class="sv-g sv-g-2"><img src="/Siviez/IMG_7613.jpg" alt="" loading="lazy" /></div>
          <div class="sv-g sv-g-3"><img src="/Siviez/IMG_1819.jpg" alt="" loading="lazy" /></div>
          <div class="sv-g sv-g-4"><img src="/Siviez/IMG_7645.jpg" alt="" loading="lazy" /></div>
          <div class="sv-g sv-g-5"><img src="/Siviez/IMG_7646.jpg" alt="" loading="lazy" /></div>
          <div class="sv-g sv-g-6"><img src="/Siviez/IMG_7647.jpg" alt="" loading="lazy" /></div>
          <div class="sv-g sv-g-7"><img src="/Siviez/IMG_1791.jpg" alt="" loading="lazy" /></div>
        </div>
      </div>
    </section>

    <section class="sv-section">
      <div class="sv-container">
        <div class="sv-reveal">
          <div class="sv-kicker" data-i18n="tips.kicker">Puppy's picks</div>
          <h2 class="sv-title" data-i18n="tips.title">Small things that make a <em>big</em> difference.</h2>
        </div>
        <div class="sv-tips">
          <div class="sv-tip sv-reveal"><span class="sv-tip-num">01</span><h4 data-i18n="tips.t1.title">Chez Caroline</h4><p data-i18n="tips.t1.desc">Café-restaurant on the ground floor of the Rosablanche building. Order fresh bread and pastries the day before — perfect for a slow breakfast on the terrace.</p></div>
          <div class="sv-tip sv-reveal"><span class="sv-tip-num">02</span><h4 data-i18n="tips.t2.title">Bring your own linen</h4><p data-i18n="tips.t2.desc">Pillows and duvets are provided, but bring pillowcases, duvet covers, bath towels, kitchen towels, and a dishcloth. Saves a rental fee.</p></div>
          <div class="sv-tip sv-reveal"><span class="sv-tip-num">03</span><h4 data-i18n="tips.t3.title">Grocery run</h4><p data-i18n="tips.t3.desc">The small shop below Rosablanche only opens in winter and is pricey. In summer, drive down to Haute-Nendaz for a proper supermarket.</p></div>
          <div class="sv-tip sv-reveal"><span class="sv-tip-num">04</span><h4 data-i18n="tips.t4.title">Laundry</h4><p data-i18n="tips.t4.desc">Small coin-operated laundromat on the ground floor of Rosablanche — washing machine and drying cabinet. Bring some change.</p></div>
          <div class="sv-tip sv-reveal"><span class="sv-tip-num">05</span><h4 data-i18n="tips.t5.title">Ski storage</h4><p data-i18n="tips.t5.desc">There's a locked safe in the basement of the building — perfect for storing skis, boots, and helmets so you don't have to lug them upstairs.</p></div>
          <div class="sv-tip sv-reveal"><span class="sv-tip-num">06</span><h4 data-i18n="tips.t6.title">Waste</h4><p data-i18n="tips.t6.desc">Rubbish goes in official plastic bags (available at the small shop). Drop them in the containers by the driveway on your way out.</p></div>
        </div>
      </div>
    </section>

    <section class="sv-section sv-section-forest">
      <div class="sv-container">
        <div class="sv-reveal">
          <div class="sv-kicker sv-kicker-gold" data-i18n="practical.kicker">Good to know</div>
          <h2 class="sv-title" data-i18n="practical.title">The <em>practical</em> bits.</h2>
        </div>
        <div class="sv-practical">
          <div class="sv-practical-item sv-reveal">
            <h4 data-i18n="practical.checkin">Check-in</h4>
            <div class="sv-practical-val">16:00</div>
            <p data-i18n="practical.checkin.desc">Self check-in via lockbox on apartment door. Code sent by email a few days before arrival.</p>
          </div>
          <div class="sv-practical-item sv-reveal">
            <h4 data-i18n="practical.checkout">Check-out</h4>
            <div class="sv-practical-val">10:00</div>
            <p data-i18n="practical.checkout.desc">Please vacuum before leaving and drop bagged waste in the containers by the driveway.</p>
          </div>
          <div class="sv-practical-item sv-reveal">
            <h4 data-i18n="practical.parking">Parking</h4>
            <div class="sv-practical-val" data-i18n="practical.parking.val">Free · 1 car</div>
            <p data-i18n="practical.parking.desc">Free spot on the open square in front of the building. Parking card is in the sliding door of the wall cabinet.</p>
          </div>
          <div class="sv-practical-item sv-reveal">
            <h4 data-i18n="practical.langs">Languages</h4>
            <div class="sv-practical-val">NL · EN · FR</div>
            <p data-i18n="practical.langs.desc">Your host Luc speaks Dutch, English and French. Response rate 100%, replies within a day.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="sv-section sv-section-ivory sv-reviews">
      <div class="sv-container">
        <div class="sv-reveal">
          <div class="sv-kicker sv-kicker-center" data-i18n="reviews.kicker">Guest favourite</div>
          <h2 class="sv-title" data-i18n="reviews.title">Trusted by <em>37 travellers</em>.</h2>
          <div class="sv-rating-big">4.81</div>
          <div class="sv-rating-meta" data-i18n="reviews.meta">Rated on 6 categories</div>

          <div class="sv-rating-badges">
            <div class="sv-rb"><div class="sv-rb-val">5.0</div><div class="sv-rb-lbl" data-i18n="reviews.location">Location</div></div>
            <div class="sv-rb"><div class="sv-rb-val">4.8</div><div class="sv-rb-lbl" data-i18n="reviews.checkin">Check-in</div></div>
            <div class="sv-rb"><div class="sv-rb-val">4.8</div><div class="sv-rb-lbl" data-i18n="reviews.communication">Communication</div></div>
            <div class="sv-rb"><div class="sv-rb-val">4.8</div><div class="sv-rb-lbl" data-i18n="reviews.accuracy">Accuracy</div></div>
            <div class="sv-rb"><div class="sv-rb-val">4.6</div><div class="sv-rb-lbl" data-i18n="reviews.cleanliness">Cleanliness</div></div>
            <div class="sv-rb"><div class="sv-rb-val">4.6</div><div class="sv-rb-lbl" data-i18n="reviews.value">Value</div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="sv-final">
      <h2 data-i18n="final.title">Ready for the <em>mountains</em>?</h2>
      <p data-i18n="final.desc">Availability, prices, and instant booking all through Airbnb. Any questions before booking — send Luc a message, he'll get back to you within a day.</p>
      <a href="https://www.airbnb.com/rooms/10012437?utm_source=siviez.com&utm_medium=web&utm_campaign=final_cta" target="_blank" rel="noopener" data-track="airbnb_final" class="sv-btn sv-btn-primary" data-i18n="cta.final">Book on Airbnb</a>
    </section>

    <footer class="sv-footer">
      <div class="sv-footer-standard sv-footer-line-1">
        © 2026 PUPVANH Projects <span class="ember-dot">•</span> alle rechten voorbehouden
      </div>
      <div class="sv-footer-standard sv-footer-line-2">
        BUILT AUG 2026 <span class="ember-dot">•</span> UPDATED AUG 2026 <span class="ember-dot">•</span> Rosablanche C34 <span class="ember-dot">•</span> <a href="https://pupvanh.vercel.app">pupvanh.vercel.app →</a>
      </div>
    </footer>

  </div>

<style is:global>
  html { scroll-behavior: smooth; }
</style>

<style>
  .siviez-page {
    /* Own palette, scoped to this page */
    --sv-teal: #0E6B6F;
    --sv-teal-dark: #084E52;
    --sv-gold: #C8A35F;
    --sv-gold-light: #E0C289;
    --sv-ember: #E85D2F;
    --sv-ivory: #F4F0E8;
    --sv-ivory-warm: #EDE6D6;
    --sv-forest: #1E3A34;
    --sv-snow: #FBFAF6;
    --sv-charcoal: #2A2A2A;

    color: var(--sv-forest);
    background: var(--sv-snow);
    line-height: 1.6;
    font-family: 'Inter', system-ui, sans-serif;
  }

  /* Full-bleed by resetting body margin implicitly — Layout uses default body */
  .siviez-page * { box-sizing: border-box; }
  .siviez-page a { color: inherit; }

  /* ===== TOPBAR ===== */
  .sv-topbar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: 20px 32px;
    display: flex; justify-content: space-between; align-items: center;
    transition: all 0.4s ease;
    background: transparent;
  }
  .sv-topbar.scrolled {
    background: rgba(251, 250, 246, 0.92);
    backdrop-filter: blur(12px);
    padding: 14px 32px;
    border-bottom: 1px solid rgba(14, 107, 111, 0.1);
  }
  .sv-brand {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--sv-snow); text-decoration: none;
    transition: color 0.4s;
    display: flex; align-items: center; gap: 10px;
  }
  .sv-topbar.scrolled .sv-brand { color: var(--sv-forest); }
  .sv-brand::before { content: '←'; font-size: 14px; transition: transform 0.3s; }
  .sv-brand:hover::before { transform: translateX(-4px); }

  .sv-lang {
    display: flex; gap: 4px;
    background: rgba(251, 250, 246, 0.15);
    padding: 4px; border-radius: 100px;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.2);
  }
  .sv-topbar.scrolled .sv-lang {
    background: rgba(14, 107, 111, 0.08);
    border-color: rgba(14, 107, 111, 0.15);
  }
  .sv-lang-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 600; letter-spacing: 0.1em;
    padding: 6px 12px; border: none; background: transparent;
    color: var(--sv-snow); cursor: pointer;
    border-radius: 100px; transition: all 0.3s;
  }
  .sv-topbar.scrolled .sv-lang-btn { color: var(--sv-forest); }
  .sv-lang-btn.active { background: var(--sv-gold); color: var(--sv-forest); }
  .sv-lang-btn:hover:not(.active) { background: rgba(255,255,255,0.1); }
  .sv-topbar.scrolled .sv-lang-btn:hover:not(.active) { background: rgba(14, 107, 111, 0.1); }

  /* ===== FLOATING CTA ===== */
  .sv-float {
    position: fixed; bottom: 24px; right: 24px; z-index: 90;
    background: var(--sv-ember); color: var(--sv-snow);
    padding: 14px 24px; border-radius: 100px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 600; letter-spacing: 0.15em;
    text-transform: uppercase; text-decoration: none;
    box-shadow: 0 12px 32px rgba(232, 93, 47, 0.4);
    transition: all 0.3s;
    display: flex; align-items: center; gap: 8px;
    opacity: 0; transform: translateY(20px); pointer-events: none;
  }
  .sv-float.visible { opacity: 1; transform: translateY(0); pointer-events: all; }
  .sv-float:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(232, 93, 47, 0.5); }
  .sv-float::after { content: '→'; transition: transform 0.3s; }
  .sv-float:hover::after { transform: translateX(4px); }

  /* ===== HERO ===== */
  .sv-hero {
    position: relative; height: 100vh; min-height: 640px;
    overflow: hidden; display: flex; align-items: flex-end;
    color: var(--sv-snow);
  }
  .sv-hero-bg {
    position: absolute; inset: 0;
    background-image: url('/Siviez/app-balcony.jpg');
    background-size: cover; background-position: center;
    transform: scale(1.05); will-change: transform;
  }
  .sv-hero-bg::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(30,58,52,0.35) 0%, rgba(30,58,52,0) 30%, rgba(30,58,52,0) 55%, rgba(30,58,52,0.85) 100%);
  }
  .sv-hero-content {
    position: relative; z-index: 2;
    padding: 0 8vw 80px; width: 100%; max-width: 1400px; margin: 0 auto;
  }
  .sv-hero-kicker {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--sv-gold-light); margin-bottom: 20px;
    display: flex; align-items: center; gap: 14px;
