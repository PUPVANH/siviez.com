  function setLang(lang) {
    document.documentElement.lang = lang;
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (i18n[lang][key]) el.textContent = i18n[lang][key];
    });
    document.querySelectorAll('[data-i18n-html]').forEach(el => {
      const key = el.getAttribute('data-i18n-html');
      if (i18n[lang][key]) el.innerHTML = i18n[lang][key];
    });
    document.querySelectorAll('.lang-toggle button').forEach(b => {
      b.classList.toggle('active', b.dataset.lang === lang);
    });
    try { localStorage.setItem('siviez-lang', lang); } catch(e){}
  }
  document.querySelectorAll('.lang-toggle button').forEach(b => {
    b.addEventListener('click', () => setLang(b.dataset.lang));
  });
  let initial = 'nl';
  try {
    const stored = localStorage.getItem('siviez-lang');
    if (stored && i18n[stored]) initial = stored;
    else {
      const nav = (navigator.language || 'nl').slice(0,2);
      if (i18n[nav]) initial = nav;
    }
  } catch(e){}
  setLang(initial);

  // Vercel Analytics custom event tracking
  document.querySelectorAll('[data-track]').forEach(el => {
    el.addEventListener('click', function() {
      const eventName = this.getAttribute('data-track');
      const url = this.href || '';
      let campaign = 'unknown';
      try { campaign = new URL(url).searchParams.get('utm_campaign') || 'unknown'; } catch(e){}
      if (window.va && typeof window.va === 'function') {
        window.va('event', { name: eventName, campaign: campaign, source: 'siviez.com', page: 'appartement' });
      }
    });
  });

  // Reveal-on-scroll nav
  const revealNav = document.getElementById('revealNav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 200) revealNav.classList.add('visible');
    else revealNav.classList.remove('visible');
  });

  // FAQ
  document.querySelectorAll('.faq-q').forEach(btn => {
    btn.addEventListener('click', () => btn.parentElement.classList.toggle('open'));
  });

  // Scroll spy
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.anchor-links a');
  window.addEventListener('scroll', () => {
    let current = '';
    sections.forEach(s => {
      const top = s.offsetTop - 120;
      if (window.scrollY >= top) current = s.id;
    });
    navLinks.forEach(a => {
      a.classList.toggle('active', a.getAttribute('href') === '#' + current);
    });
  });

  // Floating book widget drag
  (function() {
    const fb = document.getElementById('floatBook');
    const bookLink = fb.querySelector('a');
    let dragging = false, hasMoved = false;
    let startX = 0, startY = 0, offsetX = 0, offsetY = 0;
    try {
      const saved = JSON.parse(localStorage.getItem('siviez-book-pos') || 'null');
      if (saved && typeof saved.x === 'number') {
        fb.style.left = Math.min(saved.x, window.innerWidth - 100) + 'px';
        fb.style.top = Math.min(saved.y, window.innerHeight - 60) + 'px';
        fb.style.right = 'auto'; fb.style.bottom = 'auto';
      }
    } catch(e) {}
    function getPoint(e) { return e.touches && e.touches[0] ? e.touches[0] : e; }
    function onDown(e) {
      dragging = true; hasMoved = false;
      const pt = getPoint(e);
      const rect = fb.getBoundingClientRect();
      offsetX = pt.clientX - rect.left; offsetY = pt.clientY - rect.top;
      startX = pt.clientX; startY = pt.clientY;
    }
    function onMove(e) {
      if (!dragging) return;
      const pt = getPoint(e);
      const dx = Math.abs(pt.clientX - startX), dy = Math.abs(pt.clientY - startY);
      if (dx > 5 || dy > 5) { if (!hasMoved) fb.classList.add('dragging'); hasMoved = true; }
      if (hasMoved) {
        if (e.cancelable) e.preventDefault();
        let x = pt.clientX - offsetX, y = pt.clientY - offsetY;
        x = Math.max(8, Math.min(window.innerWidth - fb.offsetWidth - 8, x));
        y = Math.max(8, Math.min(window.innerHeight - fb.offsetHeight - 8, y));
        fb.style.left = x + 'px'; fb.style.top = y + 'px';
        fb.style.right = 'auto'; fb.style.bottom = 'auto';
      }
    }
    function onUp() {
      if (!dragging) return;
      dragging = false; fb.classList.remove('dragging');
      if (hasMoved) {
        const rect = fb.getBoundingClientRect();
        try { localStorage.setItem('siviez-book-pos', JSON.stringify({x: rect.left, y: rect.top})); } catch(e) {}
      }
    }
    bookLink.addEventListener('click', (e) => { if (hasMoved) { e.preventDefault(); hasMoved = false; } });
    fb.addEventListener('mousedown', onDown);
    fb.addEventListener('touchstart', onDown, {passive: true});
    window.addEventListener('mousemove', onMove);
    window.addEventListener('touchmove', onMove, {passive: false});
    window.addEventListener('mouseup', onUp);
    window.addEventListener('touchend', onUp);
  })();
</script>
