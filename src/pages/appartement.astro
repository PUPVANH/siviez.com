    function setLanguage(lang) {
      document.documentElement.lang = lang;
      document.querySelectorAll('[data-i18n]').forEach(function(el) {
        var key = el.getAttribute('data-i18n');
        if (translations[lang] && translations[lang][key]) {
          el.innerHTML = translations[lang][key];
        }
      });
      document.querySelectorAll('.sv-lang-btn').forEach(function(btn) {
        btn.classList.toggle('active', btn.dataset.lang === lang);
      });
      try { localStorage.setItem('siviez-lang', lang); } catch(e) {}
    }

    document.querySelectorAll('.sv-lang-btn').forEach(function(btn) {
      btn.addEventListener('click', function() { setLanguage(btn.dataset.lang); });
    });

    var savedLang = null;
    try { savedLang = localStorage.getItem('siviez-lang'); } catch(e) {}
    if (savedLang && translations[savedLang]) {
      setLanguage(savedLang);
    } else {
      var browserLang = (navigator.language || 'en').slice(0, 2);
      if (translations[browserLang]) setLanguage(browserLang);
    }

    var topbar = document.getElementById('svTopbar');
    var floatCta = document.getElementById('svFloat');
    var heroBg = document.getElementById('svHeroBg');

    window.addEventListener('scroll', function() {
      var y = window.scrollY;
      if (topbar) topbar.classList.toggle('scrolled', y > 80);
      if (floatCta) floatCta.classList.toggle('visible', y > window.innerHeight * 0.6);
      if (heroBg && y < window.innerHeight) {
        heroBg.style.transform = 'scale(1.05) translateY(' + (y * 0.3) + 'px)';
      }
    });

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -80px 0px' });

    document.querySelectorAll('.sv-reveal').forEach(function(el) { observer.observe(el); });
  })();
</script>

<script is:inline>
  document.querySelectorAll('[data-track]').forEach(function(el) {
    el.addEventListener('click', function() {
      var eventName = this.getAttribute('data-track');
      if (window.va && typeof window.va === 'function') {
        window.va('event', { name: eventName, source: 'siviez.com', page: 'appartement' });
      }
    });
  });
  window.addEventListener('siviez-lang-change', function(e) {
    var setLangFn = window.setLanguage;
    if (typeof setLangFn === 'function') setLangFn(e.detail.lang);
  });
</script>

