---
import Analytics from '@vercel/analytics/astro';
---
<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rosablanche C34 · Ski-in/ski-out appartement Siviez · 4 Vallées</title>
<meta name="description" content="Ruim ski-in/ski-out appartement voor 7 in Siviez, hart van het 4 Vallées skigebied (410 km pistes). Zuidgericht terras, gratis parking. Boek via Airbnb.">
<link rel="canonical" href="https://siviez.com/appartement">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">

<meta property="og:type" content="website">
<meta property="og:title" content="Rosablanche C34 · Ski-in appartement in Siviez">
<meta property="og:description" content="Ruim mountain apartment voor 7 in het hart van het 4 Vallées skigebied. Ski-in/ski-out. Boek via Airbnb.">
<meta property="og:image" content="https://pupvanh.vercel.app/siviez/IMG_7608.jpg">
<meta property="og:url" content="https://siviez.com/appartement">
<meta property="og:locale" content="nl_BE">
<meta property="og:locale:alternate" content="en_US">
<meta property="og:locale:alternate" content="fr_FR">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "VacationRental",
  "name": "Rosablanche C34 — Ski-in/ski-out apartment in Siviez",
  "description": "Spacious mountain apartment for up to 7 in Siviez, Valais, Switzerland. Ski-in/ski-out access to the 4 Vallées ski area (410 km of pistes).",
  "url": "https://siviez.com/appartement",
  "image": ["https://pupvanh.vercel.app/siviez/IMG_7608.jpg","https://pupvanh.vercel.app/siviez/IMG_1797.jpg","https://pupvanh.vercel.app/siviez/IMG_1625.jpg"],
  "address": {"@type": "PostalAddress","addressLocality": "Siviez","addressRegion": "Valais","postalCode": "1997","addressCountry": "CH"},
  "geo": {"@type": "GeoCoordinates","latitude": 46.13471,"longitude": 7.31674},
  "numberOfRooms": 1,
  "occupancy": {"@type": "QuantitativeValue","maxValue": 7},
  "amenityFeature": [
    {"@type": "LocationFeatureSpecification","name": "Ski-in/ski-out","value": true},
    {"@type": "LocationFeatureSpecification","name": "Free parking","value": true},
    {"@type": "LocationFeatureSpecification","name": "Wi-Fi","value": true},
    {"@type": "LocationFeatureSpecification","name": "Elevator","value": true},
    {"@type": "LocationFeatureSpecification","name": "Ski storage","value": true}
  ],
  "aggregateRating": {"@type": "AggregateRating","ratingValue": "4.81","reviewCount": 37,"bestRating": "5"},
  "potentialAction": {"@type": "ReserveAction","target": "https://www.airbnb.com/rooms/10012437","name": "Book on Airbnb"}
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {"@type":"Question","name":"Is it really ski-in / ski-out?","acceptedAnswer":{"@type":"Answer","text":"Yes. The piste runs right up to the building. Step out of the basement ski room straight onto the snow."}},
    {"@type":"Question","name":"How many people can stay?","acceptedAnswer":{"@type":"Answer","text":"Up to 7 guests. One proper bedroom with 6 beds plus two sofa beds in the living room."}},
    {"@type":"Question","name":"Is parking included?","acceptedAnswer":{"@type":"Answer","text":"Yes, one free dedicated spot on the open square in front of the building."}},
    {"@type":"Question","name":"Is there Wi-Fi?","acceptedAnswer":{"@type":"Answer","text":"Yes, free Wi-Fi throughout the apartment."}}
  ]
}
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=JetBrains+Mono:wght@400;500&family=Inter:wght@300;400;500;600&family=Caveat:wght@500;600&display=swap" rel="stylesheet">

<style>
  :root {
    --teal:#0E6B6F; --gold:#C8A35F; --ember:#E85D2F;
    --ivory:#F4F0E8; --forest:#1E3A34; --paper:#FAF7F0;
    --line:rgba(30,58,52,0.15); --muted:rgba(30,58,52,0.6);
  }
  * { box-sizing:border-box; margin:0; padding:0; }
  html { scroll-behavior:smooth; scroll-padding-top:80px; }
  body.appartement-page {
    background:var(--ivory); color:var(--forest);
    font-family:'Inter',sans-serif; font-weight:300; line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }
  body.appartement-page::before {
    content:""; position:fixed; inset:0;
    background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.35'/%3E%3C/svg%3E");
    opacity:0.08; pointer-events:none; z-index:1; mix-blend-mode:multiply;
  }
  .container { max-width:1200px; margin:0 auto; padding:0 32px; position:relative; z-index:2; }
  img { max-width:100%; height:auto; display:block; }

  .reveal-nav {
    position:fixed; top:0; left:0; right:0; z-index:50;
    background:rgba(244,240,232,0.94);
    backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
    border-bottom:1px solid var(--line);
    transform:translateY(-100%);
    transition:transform 0.5s cubic-bezier(0.22,1,0.36,1);
  }
  .reveal-nav.visible { transform:translateY(0); }
  .nav-inner {
    display:flex; align-items:center; justify-content:space-between;
    gap:20px; padding:14px 32px; max-width:1400px; margin:0 auto;
  }
  .nav-brand {
    font-family:'Playfair Display',serif; font-size:17px; color:var(--teal);
    text-decoration:none; white-space:nowrap;
    display:flex; align-items:baseline; gap:8px;
  }
  .nav-back {
    font-family:'JetBrains Mono',monospace; font-size:10px;
    letter-spacing:1.5px; text-transform:uppercase; color:var(--muted);
    text-decoration:none; transition:color 0.2s ease;
  }
  .nav-back:hover { color:var(--teal); }
  .anchor-links {
    display:flex; gap:2px; list-style:none; flex:1; justify-content:center;
    flex-wrap:wrap;
  }
  .anchor-links a {
    font-family:'JetBrains Mono',monospace; font-size:10px;
    text-transform:uppercase; letter-spacing:1.5px; color:var(--forest);
    text-decoration:none; padding:8px 12px; border-radius:999px;
    transition:all 0.2s ease;
  }
  .anchor-links a:hover { background:var(--forest); color:var(--ivory); }
  .anchor-links a.active { background:var(--teal); color:var(--ivory); }
  .lang-toggle {
    display:flex; gap:0; font-family:'JetBrains Mono',monospace; font-size:10px;
  }
  .lang-toggle button {
    background:none; border:none; color:var(--muted); padding:6px 6px;
    cursor:pointer; font:inherit; letter-spacing:1px;
  }
  .lang-toggle button:hover { color:var(--forest); }
  .lang-toggle button.active { color:var(--teal); font-weight:500; }
  .nav-cta {
    background:var(--ember); color:var(--ivory); padding:10px 18px;
    border-radius:999px; text-decoration:none;
    font-family:'JetBrains Mono',monospace; font-size:10px;
    letter-spacing:1.5px; text-transform:uppercase; white-space:nowrap;
    transition:background 0.2s ease, transform 0.2s ease;
  }
  .nav-cta:hover { background:var(--forest); transform:translateY(-1px); }

  .hero {
    padding:140px 0 80px;
    background:
      radial-gradient(ellipse at top, rgba(14,107,111,0.08), transparent 60%),
      var(--ivory);
    text-align:center; position:relative; z-index:2;
  }
  .hero-kicker {
    font-family:'JetBrains Mono',monospace; font-size:11px;
    letter-spacing:3px; text-transform:uppercase; color:var(--teal);
    margin-bottom:32px;
  }
  h1 {
    font-family:'Playfair Display',serif; font-weight:400;
    font-size:clamp(56px,10vw,130px); line-height:1; color:var(--forest);
    margin-bottom:32px; letter-spacing:-0.02em;
  }
  h1 em { font-style:italic; color:var(--teal); font-weight:400; }
  .hero-lede {
    font-size:19px; color:var(--forest); max-width:620px;
    margin:0 auto 40px; line-height:1.6;
  }
  .hero-buttons {
    display:flex; gap:12px; justify-content:center; flex-wrap:wrap;
    margin-bottom:60px;
  }
  .btn-primary {
    background:var(--ember); color:var(--ivory); padding:16px 28px;
    border-radius:999px; text-decoration:none;
    font-family:'JetBrains Mono',monospace; font-size:12px;
    letter-spacing:1.5px; text-transform:uppercase;
    transition:background 0.2s ease, transform 0.2s ease;
    display:inline-flex; align-items:center; gap:8px;
  }
  .btn-primary:hover { background:var(--forest); transform:translateY(-2px); }
  .btn-secondary {
    background:transparent; color:var(--forest); padding:16px 28px;
    border-radius:999px; text-decoration:none; border:1px solid var(--forest);
    font-family:'JetBrains Mono',monospace; font-size:12px;
    letter-spacing:1.5px; text-transform:uppercase;
    transition:background 0.2s ease, color 0.2s ease;
  }
  .btn-secondary:hover { background:var(--forest); color:var(--ivory); }

  .counters {
    display:grid; grid-template-columns:repeat(5,1fr);
    gap:1px; background:var(--line); border-top:1px solid var(--line);
    border-bottom:1px solid var(--line); max-width:1000px; margin:0 auto;
  }
  .counter { background:var(--ivory); padding:32px 20px; text-align:center; }
  .counter-num {
    font-family:'Playfair Display',serif; font-style:italic;
    font-size:48px; color:var(--teal); line-height:1;
  }
  .counter-label {
    font-family:'JetBrains Mono',monospace; font-size:10px;
    letter-spacing:2px; text-transform:uppercase; color:var(--muted);
    margin-top:8px;
  }

  .marquee {
    background:var(--forest); color:var(--gold);
    padding:20px 0; overflow:hidden; position:relative; z-index:2;
    margin-top:60px;
  }
  .marquee-track {
    display:flex; gap:60px; white-space:nowrap;
    animation:scroll 40s linear infinite;
    font-family:'Playfair Display',serif; font-style:italic; font-size:26px;
  }
  .marquee-track span::before {
    content:"◆"; color:var(--ember); margin-right:60px; font-size:12px;
  }
  @keyframes scroll { from { transform:translateX(0); } to { transform:translateX(-50%); } }

  section { padding:100px 0; position:relative; z-index:2; }
  section.bg-paper { background:var(--paper); }
  section.bg-forest { background:var(--forest); color:var(--ivory); }
  section.bg-forest h2 { color:var(--ivory); }
  section.bg-forest h2 em { color:var(--gold); }
  section.bg-forest .eyebrow { color:var(--gold); }

  .eyebrow {
    font-family:'JetBrains Mono',monospace; font-size:11px;
    letter-spacing:2px; text-transform:uppercase; color:var(--teal); margin-bottom:16px;
  }
  h2 {
    font-family:'Playfair Display',serif; font-weight:400;
    font-size:clamp(32px,5vw,56px); line-height:1.1; color:var(--forest);
    margin-bottom:32px; max-width:780px;
  }
  h2 em { font-style:italic; color:var(--teal); }
  section.bg-forest h2 em, section.bg-forest .prose em { color:var(--gold); }
  .lede { font-size:17px; color:var(--muted); max-width:620px; line-height:1.7; margin-bottom:48px; }
  .prose { max-width:620px; font-size:17px; line-height:1.75; color:var(--forest); }
  .prose p { margin-bottom:20px; }
  .prose em { font-style:italic; color:var(--teal); }
  .host-line {
    margin-top:24px; padding-top:24px; border-top:1px solid var(--line);
    font-size:15px; color:var(--muted);
  }
  .host-line em { color:var(--gold); font-style:italic; }

  .two-col {
    display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:start;
  }
  .col-eyebrow {
    font-family:'JetBrains Mono',monospace; font-size:10px;
    letter-spacing:2px; text-transform:uppercase; color:var(--gold);
    margin-bottom:12px;
  }
  .col-title {
    font-family:'Playfair Display',serif; font-size:32px; line-height:1.15;
    color:var(--forest); margin-bottom:20px;
  }
  section.bg-forest .col-title { color:var(--ivory); }
  .col-body { font-size:16px; color:var(--forest); line-height:1.7; }
  section.bg-forest .col-body { color:rgba(244,240,232,0.85); }

  .hike-list {
    list-style:none; padding:0; margin-top:40px; max-width:720px;
  }
  .hike-list li {
    padding:22px 0; border-bottom:1px solid var(--line);
    font-size:17px; color:var(--forest); line-height:1.5;
    display:flex; gap:16px; align-items:baseline;
  }
  .hike-list li:last-child { border-bottom:none; }
  .hike-list li strong { font-weight:500; color:var(--teal); }
  .hike-arrow {
    color:var(--gold); font-family:'JetBrains Mono',monospace;
    font-size:14px; flex-shrink:0;
  }

  .photo-break { margin:0; padding:0; position:relative; z-index:2; }
  .photo-break img {
    width:100%; height:clamp(240px,40vw,460px); object-fit:cover;
  }

  .why-grid {
    display:grid; grid-template-columns:repeat(3,1fr);
    gap:1px; background:var(--line); border:1px solid var(--line);
  }
  .why-card {
    background:var(--paper); padding:36px 28px;
    display:flex; flex-direction:column; gap:12px;
    transition:background 0.2s ease;
  }
  .why-card:hover { background:var(--ivory); }
  .why-num {
    font-family:'JetBrains Mono',monospace; font-size:10px;
    color:var(--gold); letter-spacing:2px;
  }
  .why-title {
    font-family:'Playfair Display',serif; font-size:22px;
    font-style:italic; color:var(--forest);
  }
  .why-body { font-size:14px; color:var(--muted); line-height:1.6; }

  .amenities-grid {
    display:grid; grid-template-columns:repeat(2,1fr); gap:0;
    margin-top:40px;
  }
  .amenity {
    padding:20px 0; border-bottom:1px solid var(--line);
    display:flex; gap:16px; align-items:flex-start;
  }
  .amenity-num {
    font-family:'JetBrains Mono',monospace; font-size:11px;
    color:var(--gold); letter-spacing:1.5px; min-width:30px; padding-top:3px;
  }
  .amenity-text { font-size:15px; color:var(--forest); line-height:1.5; }

  .cta-strip {
    background:var(--forest); color:var(--ivory);
    padding:36px 40px; margin:60px 0;
    display:flex; align-items:center; justify-content:space-between;
    gap:32px; border-radius:4px; flex-wrap:wrap;
    position:relative; z-index:2;
  }
  .cta-strip-text {
    font-family:'Playfair Display',serif; font-style:italic; font-size:24px;
    color:var(--ivory); flex:1; min-width:240px;
  }
  .cta-strip-text em { color:var(--gold); }
  .cta-strip a {
    background:var(--ember); color:var(--ivory); padding:14px 26px;
    border-radius:999px; text-decoration:none;
    font-family:'JetBrains Mono',monospace; font-size:11px;
    letter-spacing:1.5px; text-transform:uppercase; white-space:nowrap;
    transition:background 0.2s ease, transform 0.2s ease;
  }
  .cta-strip a:hover { background:var(--gold); color:var(--forest); transform:translateY(-2px); }

  .photogrid {
    display:grid; grid-template-columns:repeat(4,1fr); gap:6px; margin-top:40px;
    grid-auto-rows:220px;
  }
  .photogrid img { width:100%; height:100%; object-fit:cover; }
  .photogrid img.wide { grid-column:span 2; }
  .photogrid img.tall { grid-row:span 2; }
  .photogrid img.big { grid-column:span 2; grid-row:span 2; }

  .picks-grid {
    display:grid; grid-template-columns:repeat(3,1fr); gap:32px;
  }
  .pick-card { display:flex; flex-direction:column; gap:10px; }
  .pick-num {
    font-family:'JetBrains Mono',monospace; font-size:24px;
    color:var(--gold); letter-spacing:2px;
  }
  .pick-title {
    font-family:'Playfair Display',serif; font-size:22px;
    color:var(--forest); font-style:italic;
  }
  .pick-body { font-size:14px; color:var(--muted); line-height:1.6; }

  .facts-grid {
    display:grid; grid-template-columns:repeat(4,1fr);
    gap:1px; background:var(--line); border:1px solid var(--line);
  }
  .fact { background:var(--paper); padding:32px 24px; }
  .fact-label {
    font-family:'JetBrains Mono',monospace; font-size:10px;
    letter-spacing:2px; text-transform:uppercase; color:var(--gold);
    margin-bottom:8px;
  }
  .fact-value {
    font-family:'Playfair Display',serif; font-size:28px; font-style:italic;
    color:var(--forest); margin-bottom:8px;
  }
  .fact-body { font-size:13px; color:var(--muted); line-height:1.5; }

  .arrival-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
  .arrival-card {
    background:var(--paper); border:1px solid var(--line);
    padding:36px 28px; display:flex; flex-direction:column; gap:14px;
  }
  .arrival-icon { width:36px; height:36px; color:var(--teal); }
  .arrival-label {
    font-family:'JetBrains Mono',monospace; font-size:10px;
    letter-spacing:2px; text-transform:uppercase; color:var(--gold);
  }
  .arrival-title {
    font-family:'Playfair Display',serif; font-style:italic;
    font-size:24px; color:var(--forest);
  }
  .arrival-body { font-size:14px; color:var(--muted); line-height:1.7; }
  .arrival-body strong { color:var(--forest); font-weight:500; }
  .arrival-note {
    margin-top:24px; padding:20px 24px; background:var(--paper);
    border-left:3px solid var(--ember); font-size:14px; color:var(--forest);
    line-height:1.6;
  }
  .arrival-note strong {
    font-family:'Caveat',cursive; font-size:20px; color:var(--ember);
    display:block; margin-bottom:2px; letter-spacing:0;
  }

  .reviews {
    display:grid; grid-template-columns:1fr 2fr; gap:60px; align-items:center;
  }
  .review-big { text-align:center; }
  .review-big-num {
    font-family:'Playfair Display',serif; font-size:100px; line-height:1;
    color:var(--teal); font-style:italic;
  }
  .review-big-label {
    font-family:'JetBrains Mono',monospace; font-size:11px;
    letter-spacing:2px; text-transform:uppercase; color:var(--muted);
    margin-top:12px;
  }
  .review-grid {
    display:grid; grid-template-columns:repeat(3,1fr); gap:1px;
    background:var(--line); border:1px solid var(--line);
  }
  .review-item { background:var(--paper); padding:24px; }
  .review-num {
    font-family:'Playfair Display',serif; font-style:italic;
    font-size:32px; color:var(--forest);
  }
  .review-label {
    font-family:'JetBrains Mono',monospace; font-size:10px;
    letter-spacing:1.5px; text-transform:uppercase; color:var(--muted); margin-top:6px;
  }

  .faq-list { max-width:820px; margin:0 auto; }
  .faq-item { border-bottom:1px solid var(--line); }
  .faq-item:first-child { border-top:1px solid var(--line); }
  .faq-q {
    width:100%; background:none; border:none;
    padding:28px 0; display:flex; align-items:center; justify-content:space-between;
    cursor:pointer; text-align:left;
    font-family:'Playfair Display',serif; font-size:22px;
    color:var(--forest); font-style:italic;
    transition:color 0.2s ease;
  }
  .faq-q:hover { color:var(--teal); }
  .faq-toggle {
    font-family:'JetBrains Mono',monospace; font-size:20px;
    color:var(--teal); transition:transform 0.3s ease; flex-shrink:0; margin-left:20px;
  }
  .faq-item.open .faq-toggle { transform:rotate(45deg); }
  .faq-a {
    max-height:0; overflow:hidden; transition:max-height 0.4s ease, padding 0.3s ease;
    color:var(--muted); font-size:15px; line-height:1.7;
  }
  .faq-item.open .faq-a { max-height:500px; padding-bottom:28px; }

  .final-cta { text-align:center; padding:120px 0; }
  .final-cta h2 { margin:0 auto 24px; text-align:center; }
  .final-cta .lede { margin:0 auto 40px; }

  .float-book {
    position:fixed; bottom:24px; right:24px; z-index:999;
    background:var(--ember); color:var(--ivory);
    border-radius:999px; padding:12px 18px 12px 14px;
    display:flex; align-items:center; gap:10px;
    box-shadow:0 8px 28px rgba(232,93,47,0.4), 0 3px 10px rgba(0,0,0,0.15);
    cursor:grab; user-select:none; touch-action:none;
    transition:transform 0.25s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.25s ease;
    font-family:'JetBrains Mono',monospace;
    font-size:11px; letter-spacing:1.5px; text-transform:uppercase;
    animation:floatIn 0.6s cubic-bezier(0.34,1.56,0.64,1) 0.8s both;
  }
  @keyframes floatIn {
    from { transform:translateY(20px) scale(0.8); opacity:0; }
    to { transform:translateY(0) scale(1); opacity:1; }
  }
  .float-book:hover {
    transform:translateY(-3px) scale(1.03);
    box-shadow:0 12px 36px rgba(232,93,47,0.5), 0 4px 14px rgba(0,0,0,0.2);
  }
  .float-book.dragging {
    cursor:grabbing;
    transform:rotate(-3deg) scale(1.08);
    transition:none;
  }
  .float-book a {
    color:var(--ivory); text-decoration:none;
    display:flex; align-items:center; gap:8px; white-space:nowrap;
  }
  .float-grip {
    display:flex; flex-direction:column; gap:3px; flex-shrink:0;
    padding:2px 4px 2px 0; opacity:0.65;
  }
  .float-grip span {
    display:block; width:3px; height:3px; border-radius:50%; background:var(--ivory);
  }

  footer {
