---
// /discover/village — "The village": what Siviez is, the Cleuson dam & lake,
// the Saint-Barthélémy chapel, the Printse river, and how to get there.
// Trilingual NL/EN/FR via the shared siviez-lang switch.
import Layout from '../../layouts/Layout.astro';
import SiviezNav from '../../components/SiviezNav.astro';

const pageTitle = 'The village of Siviez · A local guide to the 4 Vallées hamlet';
const pageDescription = 'Discover Siviez (1730m) at the head of the Nendaz valley — the turquoise Lac de Cleuson and its dam, the historic Chapelle Saint-Barthélémy, the Printse river, and how to get there. A local guide.';

// Structured data — this page is about the place itself.
const schema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Siviez",
  "description": "Alpine hamlet at 1730m at the head of the Nendaz valley in Valais, Switzerland — gateway to the 4 Vallées ski area, home to the Lac de Cleuson and the Chapelle Saint-Barthélémy.",
  "url": "https://siviez.com/discover/village",
  "image": "https://siviez.com/photos/village/lac-de-cleuson-panorama.jpg",
  "geo": { "@type": "GeoCoordinates", "latitude": 46.13471, "longitude": 7.31674 },
  "containedInPlace": { "@type": "Place", "name": "Nendaz, Valais, Switzerland" },
  "touristType": ["Hikers", "Skiers", "Families", "Nature lovers"]
};
---

<Layout title={pageTitle} description={pageDescription} ogImage="https://siviez.com/photos/village/lac-de-cleuson-panorama.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <SiviezNav />

  <!-- 1 · HERO -->
  <section class="hero">
    <div class="hero-inner">
      <div class="kicker" data-i18n="v.kicker">Discover · Valais · 1730m</div>
      <h1>The <em data-i18n="v.title.em">village</em></h1>
      <p class="hero-tag" data-i18n="v.tag">Where the road stops and the mountains begin.</p>
    </div>
  </section>

  <div class="page">

    <!-- 2 · INTRO -->
    <section class="intro">
      <p class="lead" data-i18n="v.intro.lead">
        Siviez is a small alpine hamlet at 1730 metres, at the very head of the Nendaz valley in Valais.
        It's the last stop before the mountains take over — and the quiet back door into one of the largest
        ski areas in the world, the 4 Vallées.
      </p>
      <p data-i18n="v.intro.body">
        There's no old stone village square here. Siviez is a handful of buildings gathered around the lift
        station, where the Printse river runs down from the Cleuson dam. In winter it's a ski hub; in summer
        it's a trailhead. What it lacks in postcard charm it makes up for in space, silence, and a front-row
        seat to the high Alps.
      </p>
    </section>

    <!-- 3 · LAC DE CLEUSON & DAM -->
    <section class="feature">
      <div class="feature-text">
        <div class="section-kicker" data-i18n="v.cleuson.kicker">Above the village</div>
        <h2>Lac de <em data-i18n="v.cleuson.em">Cleuson</em></h2>
        <p data-i18n="v.cleuson.p1">
          A short climb above Siviez lies the Lac de Cleuson — a turquoise reservoir at 2179 metres, held back
          by a dam wall built between 1947 and 1950. At 87 metres high and 420 metres long, it holds some
          20 million cubic metres of water and feeds the great Grande Dixence hydroelectric scheme.
        </p>
        <p data-i18n="v.cleuson.p2">
          The colour of the water changes with the season and the light — milky jade after the snowmelt,
          deep turquoise in high summer. It's about an hour and a quarter on foot from the village, following
          the Printse upstream.
        </p>
        <div class="tip">
          <span class="tip-label" data-i18n="v.tip.label">Puppy's tip</span>
          <p data-i18n="v.cleuson.tip">
            Go early. The valley faces west, so the light on the water is best in the morning, and you'll have
            the path largely to yourself before the day-trippers arrive.
          </p>
        </div>
      </div>
      <div class="feature-img">
        <img src="/photos/village/lac-de-cleuson-dam-view.jpg" alt="Turquoise Lac de Cleuson and its dam wall above Siviez, Valais" loading="lazy" />
      </div>
    </section>

    <!-- 4 · CHAPEL -->
    <section class="feature reverse">
      <div class="feature-text">
        <div class="section-kicker" data-i18n="v.chapel.kicker">History</div>
        <h2>Chapelle <em data-i18n="v.chapel.em">Saint-Barthélémy</em></h2>
        <p data-i18n="v.chapel.p1">
          Just behind the dam stands a small white chapel — the oldest in all of Nendaz. A document from 1447,
          signed by the Bishop of Sion, already mentions it, which means the building is older still.
        </p>
        <p data-i18n="v.chapel.p2">
          The original wooden chapel stood lower down, in the Cleuson valley itself. When the dam was built,
          it would have been lost — so in 1951 the dam workers built a new stone chapel on the present site,
          looking out over the valley towards the Bernese Alps.
        </p>
        <div class="tip">
          <span class="tip-label" data-i18n="v.tip.label">Puppy's tip</span>
          <p data-i18n="v.chapel.tip">
            Every year on 24 August, the cheeses from the surrounding mountain pastures are blessed here during
            a service — a genuine local tradition that almost no visitor ever sees.
          </p>
        </div>
      </div>
      <div class="feature-img">
        <img src="/photos/village/chapelle-saint-barthelemy-nendaz.jpg" alt="The white Chapelle Saint-Barthélémy, oldest chapel in Nendaz, near the Cleuson dam" loading="lazy" />
      </div>
    </section>

    <!-- 5 · THE PRINTSE -->
    <section class="feature">
      <div class="feature-text">
        <div class="section-kicker" data-i18n="v.printse.kicker">Through the valley</div>
        <h2>The <em data-i18n="v.printse.em">Printse</em></h2>
        <p data-i18n="v.printse.p1">
          The river that runs through Siviez is the Printse. It gathers the meltwater of the high peaks,
          fills the Lac de Cleuson, and then tumbles down the valley that carries its name — the Vallée de la Printze.
        </p>
        <p data-i18n="v.printse.p2">
          Along its banks near the village you'll find a barefoot path — a 2.4-kilometre loop over grass, stones
          and cool water, made for lazy summer mornings — and a family picnic area with a barbecue.
        </p>
        <div class="tip">
          <span class="tip-label" data-i18n="v.tip.label">Puppy's tip</span>
          <p data-i18n="v.printse.tip">
            In high summer the cows graze freely on the slopes beside the water. Bring a picnic, dip your feet,
            and let the afternoon go by to the sound of cowbells.
          </p>
        </div>
      </div>
      <div class="feature-img">
        <img src="/photos/village/cows-lac-de-cleuson-pasture.jpg" alt="Cows grazing freely on the alpine pasture beside Lac de Cleuson in summer" loading="lazy" />
      </div>
    </section>

    <!-- 6 · EAT & DRINK -->
    <section class="eat">
      <div class="section-kicker" data-i18n="v.eat.kicker">Eat & drink</div>
      <h2 data-i18n="v.eat.title">Where to eat in Siviez</h2>
      <p class="eat-lead" data-i18n="v.eat.lead">
        Two places, both a short walk apart. One is in the very building of our apartment; the other guards
        the entrance to the village.
      </p>

      <div class="eat-grid">

        <article class="eat-card">
          <div class="eat-badge" data-i18n="v.eat.caroline.badge">In our building</div>
          <h3 data-i18n="v.eat.caroline.name">Chez Caroline</h3>
          <p class="eat-where" data-i18n="v.eat.caroline.where">Rosablanche building · at the foot of the slopes</p>
          <p data-i18n="v.eat.caroline.body">
            Right in the Rosablanche building — the same block as our apartment. A sunny terrace over the valley
            and the Lac de Cleuson, a seasonal menu of burgers, salads, soups and grilled meats, and breakfast
            to start the day. In winter, the Yeti Bar keeps things going after the last run.
          </p>
          <p class="eat-insider" data-i18n="v.eat.caroline.insider">
            It also works as the village bakery: order your bread and croissants the evening before and pick
            them up fresh in the morning — a lift ride from bed.
          </p>
          <div class="pills">
            <span class="pill" data-i18n="v.eat.caroline.p1">Terrace</span>
            <span class="pill" data-i18n="v.eat.caroline.p2">Yeti Bar (winter)</span>
            <span class="pill" data-i18n="v.eat.caroline.p3">Bakery on order</span>
            <span class="pill" data-i18n="v.eat.caroline.p4">Pétanque</span>
            <span class="pill" data-i18n="v.eat.caroline.p5">Playground</span>
            <span class="pill" data-i18n="v.eat.caroline.p6">Family-friendly</span>
          </div>
          <a href="https://www.chezcaroline.ch/" target="_blank" rel="noopener" class="eat-link" data-track="village_chezcaroline" data-i18n="v.eat.caroline.link">chezcaroline.ch ↗</a>
        </article>

        <article class="eat-card">
          <div class="eat-badge" data-i18n="v.eat.bergers.badge">Entrance of Siviez</div>
          <h3 data-i18n="v.eat.bergers.name">Restaurant Les Bergers</h3>
          <p class="eat-where" data-i18n="v.eat.bergers.where">At the entrance to the village</p>
          <p data-i18n="v.eat.bergers.body">
            An alpine-atmosphere restaurant at the entrance to Siviez, serving the real thing: open-hearth grills,
            cheese dishes and other Valais specialities, with local products at the heart of it all. In both
            summer and winter you can eat out on the sun-drenched terrace.
          </p>
          <p class="eat-insider" data-i18n="v.eat.bergers.insider">
            Also known locally as "Chez Benzine" — a proper mountain grill where the fire does the work.
          </p>
          <div class="pills">
            <span class="pill" data-i18n="v.eat.bergers.p1">Open-hearth grill</span>
            <span class="pill" data-i18n="v.eat.bergers.p2">Valais dishes</span>
            <span class="pill" data-i18n="v.eat.bergers.p3">Terrace</span>
            <span class="pill" data-i18n="v.eat.bergers.p4">Free parking</span>
            <span class="pill" data-i18n="v.eat.bergers.p5">Family-friendly</span>
          </div>
          <a href="https://www.restaurant-les-bergers.ch/" target="_blank" rel="noopener" class="eat-link" data-track="village_lesbergers" data-i18n="v.eat.bergers.link">restaurant-les-bergers.ch ↗</a>
        </article>

      </div>
    </section>

    <!-- 7 · GETTING THERE -->
    <section class="practical">
      <div class="section-kicker" data-i18n="v.getting.kicker">Getting there</div>
      <h2 data-i18n="v.getting.title">How to reach Siviez</h2>
      <div class="practical-grid">
        <div class="practical-card">
          <h3 data-i18n="v.getting.car.title">By car</h3>
          <p data-i18n="v.getting.car.body">
            About 40 minutes up from Sion, along winding mountain roads through Haute-Nendaz to the very end
            of the valley. Large parking is available in the village.
          </p>
        </div>
        <div class="practical-card">
          <h3 data-i18n="v.getting.transport.title">By public transport</h3>
          <p data-i18n="v.getting.transport.body">
            Train to Sion, then the postbus up to Haute-Nendaz, and on to Siviez. A scenic way to arrive,
            with no mountain driving.
          </p>
        </div>
        <div class="practical-card">
          <h3 data-i18n="v.getting.when.title">When to come</h3>
          <p data-i18n="v.getting.when.body">
            Winter for the 4 Vallées ski area on the doorstep; summer for hiking, the bisses and the lakes.
            Late spring and autumn are quiet and beautiful, with fewer people about.
          </p>
        </div>
      </div>
      <p class="practical-note" data-i18n="v.getting.note">
        For current road conditions, bus timetables and lift opening dates, the tourist office of Nendaz keeps
        everything up to date at <a href="https://www.nendaz.ch/en" target="_blank" rel="noopener">nendaz.ch</a>.
      </p>
    </section>

    <!-- 7 · CTA / LINKS -->
    <section class="cta">
      <h2 data-i18n="v.cta.title">Make it your base</h2>
      <p data-i18n="v.cta.body">
        Everything on this page is a few minutes from our own apartment, Rosablanche C34 —
        ski-in/ski-out in winter, a trailhead in summer.
      </p>
      <div class="cta-buttons">
        <a href="/appartement" class="btn btn-primary" data-track="village_to_apartment" data-i18n="v.cta.stay">See the apartment →</a>
        <a href="/hike" class="btn btn-ghost" data-i18n="v.cta.hike">Summer trails</a>
        <a href="/ski" class="btn btn-ghost" data-i18n="v.cta.ski">Winter & ski</a>
      </div>
    </section>

    <footer>
      <span>© 2026 · Hosted by Luc</span>
      <span class="dot">·</span>
      <span>Part of <a href="https://pupvanh.vercel.app" target="_blank" rel="noopener">PUPVANH Projects →</a></span>
    </footer>

  </div>
</Layout>

<style>
  .hero {
    position: relative; min-height: 80vh;
    display: flex; align-items: flex-end;
    padding: 120px 24px 60px; text-align: left;
    color: #F4F0E8;
    background:
      linear-gradient(180deg, rgba(15,38,34,0.35) 0%, rgba(15,38,34,0.2) 35%, rgba(15,38,34,0.75) 100%),
      url('/photos/village/lac-de-cleuson-panorama.jpg') center 45% / cover no-repeat;
  }
  .hero-inner { max-width: 1100px; margin: 0 auto; width: 100%; }
  .kicker {
    font-family: 'JetBrains Mono', monospace; font-size: 11px;
    letter-spacing: 3px; text-transform: uppercase; color: #C8A35F; margin-bottom: 18px;
  }
  h1 {
    font-family: 'Playfair Display', serif; font-weight: 400;
    font-size: clamp(56px, 10vw, 120px); line-height: 0.95; letter-spacing: -0.02em;
    margin: 0 0 18px 0;
  }
  h1 em { font-style: italic; color: #C8A35F; }
  .hero-tag {
    font-family: 'Playfair Display', serif; font-style: italic;
    font-size: clamp(18px, 3vw, 26px); color: rgba(244,240,232,0.92); max-width: 620px;
  }

  .page { background: #0F2622; color: #F4F0E8; }
  .page section { max-width: 1100px; margin: 0 auto; padding: 80px 24px; }

  .section-kicker {
    font-family: 'JetBrains Mono', monospace; font-size: 11px;
    letter-spacing: 3px; text-transform: uppercase; color: #C8A35F; margin-bottom: 16px;
  }
  h2 {
    font-family: 'Playfair Display', serif; font-weight: 400;
    font-size: clamp(34px, 5vw, 56px); line-height: 1.05; letter-spacing: -0.015em; margin-bottom: 24px;
  }
  h2 em { font-style: italic; color: #C8A35F; }
  p { font-size: 17px; line-height: 1.75; color: rgba(244,240,232,0.82); margin-bottom: 18px; }

  /* INTRO */
  .intro { border-bottom: 1px solid rgba(200,163,95,0.15); }
  .intro .lead {
    font-family: 'Playfair Display', serif; font-style: italic;
    font-size: clamp(20px, 3vw, 28px); line-height: 1.5; color: #C8A35F; margin-bottom: 28px;
  }

  /* FEATURE (foto + tekst) */
  .feature {
    display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center;
    border-bottom: 1px solid rgba(200,163,95,0.15);
  }
  .feature.reverse .feature-text { order: 2; }
  .feature.reverse .feature-img { order: 1; }
  .feature-img {
    height: 460px; border-radius: 8px; overflow: hidden;
  }
  .feature-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s ease; }
  .feature:hover .feature-img img { transform: scale(1.04); }
  .feature-text p:last-of-type { margin-bottom: 0; }

  /* TIP blok */
  .tip {
    background: rgba(232,93,47,0.10); border-left: 3px solid #E85D2F;
    border-radius: 4px; padding: 16px 20px; margin-top: 24px;
  }
  .tip-label {
    font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 2px;
    text-transform: uppercase; color: #E85D2F;
  }
  .tip p { font-size: 15px; margin: 6px 0 0 0; color: rgba(244,240,232,0.9); }

  /* EAT & DRINK */
  .eat { border-bottom: 1px solid rgba(200,163,95,0.15); }
  .eat-lead {
    font-family: 'Playfair Display', serif; font-style: italic;
    font-size: clamp(18px, 2.5vw, 22px); color: rgba(244,240,232,0.85);
    max-width: 640px; margin-bottom: 40px;
  }
  .eat-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px;
  }
  .eat-card {
    background: rgba(30,58,52,0.5); border: 1px solid rgba(200,163,95,0.2);
    border-radius: 8px; padding: 32px 30px; display: flex; flex-direction: column;
  }
  .eat-badge {
    align-self: flex-start;
    font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 2px;
    text-transform: uppercase; color: #1E3A34; background: #C8A35F;
    padding: 5px 12px; border-radius: 2px; margin-bottom: 18px;
  }
  .eat-card h3 {
    font-family: 'Playfair Display', serif; font-weight: 400; font-size: 30px;
    color: #F4F0E8; margin-bottom: 4px;
  }
  .eat-where {
    font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 1px;
    color: rgba(244,240,232,0.55); margin-bottom: 18px;
  }
  .eat-card > p { font-size: 15px; line-height: 1.65; margin-bottom: 14px; }
  .eat-insider {
    background: rgba(232,93,47,0.10); border-left: 3px solid #E85D2F;
    border-radius: 4px; padding: 12px 16px; font-size: 14px !important;
    color: rgba(244,240,232,0.9) !important;
  }
  .pills { display: flex; flex-wrap: wrap; gap: 6px; margin: 6px 0 20px; }
  .pill {
    font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.5px;
    color: #C8A35F; background: rgba(200,163,95,0.12);
    border: 1px solid rgba(200,163,95,0.25);
    padding: 4px 10px; border-radius: 999px;
  }
  .eat-link {
    margin-top: auto; align-self: flex-start;
    font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 1px;
    color: #C8A35F; text-decoration: none; padding-top: 8px;
    border-bottom: 1px solid transparent; transition: border-color 0.2s ease;
  }
  .eat-link:hover { border-bottom-color: #C8A35F; }

  /* PRACTICAL */
  .practical { border-bottom: 1px solid rgba(200,163,95,0.15); }
  .practical-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 20px;
  }
  .practical-card {
    background: rgba(30,58,52,0.5); border: 1px solid rgba(200,163,95,0.2);
    border-radius: 6px; padding: 28px 24px;
  }
  .practical-card h3 {
    font-family: 'Playfair Display', serif; font-size: 22px; color: #F4F0E8; margin-bottom: 10px;
  }
  .practical-card p { font-size: 14px; margin: 0; }
  .practical-note { margin-top: 28px; font-size: 15px; }
  .practical-note a { color: #C8A35F; }

  /* CTA */
  .cta { text-align: center; }
  .cta p { max-width: 600px; margin: 0 auto 32px; }
  .cta-buttons { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .btn {
    display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 12px;
    letter-spacing: 1.5px; text-transform: uppercase; padding: 15px 28px;
    border-radius: 999px; text-decoration: none; transition: all 0.25s ease;
  }
  .btn-primary { background: #E85D2F; color: #F4F0E8; }
  .btn-primary:hover { background: #C8A35F; color: #1E3A34; transform: translateY(-2px); }
  .btn-ghost { border: 1px solid rgba(244,240,232,0.3); color: #F4F0E8; }
  .btn-ghost:hover { border-color: #C8A35F; color: #C8A35F; }

  footer {
    max-width: 100%; text-align: center; padding: 40px 24px;
    border-top: 1px solid rgba(200,163,95,0.1);
    font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1.5px;
    text-transform: uppercase; color: rgba(244,240,232,0.5);
  }
  footer .dot { color: #E85D2F; margin: 0 8px; }
  footer a { color: #C8A35F; text-decoration: none; }

  @media (max-width: 820px) {
    .feature { grid-template-columns: 1fr; gap: 32px; }
    .feature.reverse .feature-text { order: 2; }
    .feature.reverse .feature-img { order: 1; }
    .feature-img { height: 300px; }
    .practical-grid { grid-template-columns: 1fr; }
    section { padding: 60px 20px; }
    .hero { min-height: 60vh; }
  }
</style>

<script is:inline>
